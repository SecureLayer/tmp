---
const files = [
  "controller.txt",
  "browsing.txt",
  "agent-breaker.txt",
  "booking-contact.txt",
  "your-rights.txt",
  "transfers.txt",
  "changes.txt",
];

const sections = [
  {
    h: "CONTROLLER",
    p: [
      `The data controller for <strong>securelayer.co</strong> is the publisher identified on the <a href="/legal">legal mentions</a> page.`,
      `Privacy questions and requests: book a call at <a href="https://cal.com/securelayer" target="_blank" rel="noopener noreferrer">cal.com/securelayer</a> or use Signal (link on the home page).`,
    ],
  },
  {
    h: "BROWSING",
    p: [
      `This site sets <strong>no cookies of its own</strong> and runs <strong>no analytics or tracking scripts</strong>. There is no account, newsletter, or contact form.`,
      `The site is served through <strong>Cloudflare</strong>. Like any web host, Cloudflare processes your IP address and request metadata to deliver and protect the site. Its security features may run bot-detection scripts and, on some API requests, a challenge page that can store a short-lived security cookie in your browser.`,
      `Fonts are loaded from <strong>Google Fonts</strong>; Google may log your IP address when serving them. The site sends <strong>no referrer</strong> to other sites.`,
    ],
  },
  {
    h: "AGENT BREAKER (/ai-agent)",
    p: [
      `If you submit a ticket in the Agent Breaker demo, the text you write (500 characters maximum) is sent to <strong>Anthropic</strong> (Claude API) so the fictional support agent can answer it.`,
      `The ticket text, the tool the agent called, its arguments, whether the attempt won, and a timestamp are stored in a database to study how the demo is attacked. <strong>No IP address, name, or account is stored with it.</strong> Please do not put personal data in a ticket. There is currently no automatic deletion schedule for these records.`,
      `To enforce the hourly attempt limit, a one-way hash of your IP address is kept for <strong>1 hour</strong>, then deleted automatically. A daily counter limits total plays per day and holds no personal data.`,
    ],
  },
  {
    h: "BOOKING &amp; CONTACT",
    p: [
      `Booking a call is handled by <strong>Cal.com</strong>; the name, email, and timezone you enter are processed by Cal.com under its own privacy policy. Signal messages are handled directly in Signal. None of this content is stored on this site's infrastructure.`,
    ],
  },
  {
    h: "YOUR RIGHTS",
    p: [
      `Legal basis: legitimate interest (GDPR art. 6(1)(f)) in keeping the site secure, preventing abuse, and running the demo. Under GDPR you may request access, rectification, or erasure, and object to processing.`,
      `Agent Breaker tickets and hashed IPs are not linked to an identity, so they cannot be traced back to you on request. You may lodge a complaint with the <a href="https://www.cnil.fr" target="_blank" rel="noopener noreferrer">CNIL</a> (France).`,
    ],
  },
  {
    h: "INTERNATIONAL TRANSFERS",
    p: [
      `Cloudflare, Anthropic, Google, and Cal.com may process data outside the European Economic Area, relying on their own transfer safeguards (such as the EU–US Data Privacy Framework or Standard Contractual Clauses).`,
    ],
  },
  {
    h: "CHANGES",
    p: [
      `Last updated: <strong>2026-10-04</strong>. This policy will be updated <strong>before</strong> any analytics, contact form, or new data collection goes live.`,
    ],
  },
];

// build the numbered "diff" rows once, server-side, so the whole page is static HTML —
// no client JS required to see the content (unlike an earlier draft of this page)
type Row = { html: string; added?: boolean; cls?: string };
const rows: Row[] = [];
const cmd = (html: string) => rows.push({ html, cls: "cmd" });
const blank = () => rows.push({ html: "" });

cmd(
  `<span class="user">securelayer@www</span> <span class="path">~</span> % <span class="cmdtext">ls privacy/</span>`,
);
blank();
files.forEach((f) => rows.push({ html: f, cls: "listing-row" }));
blank();
cmd(
  `<span class="user">securelayer@www</span> <span class="path">~</span> % <span class="cmdtext">cat privacy/*.txt</span>`,
);
blank();
sections.forEach((s) => {
  rows.push({ html: `<span class="heading">${s.h}</span>`, added: true });
  s.p.forEach((p) => rows.push({ html: p, added: true }));
  blank();
});
cmd(
  `<span class="user">securelayer@www</span> <span class="path">~</span> % <span class="cmdtext">cd</span> <a href="/">~</a> <span class="comment">// back home</span>`,
);
cmd(
  `<span class="user">securelayer@www</span> <span class="path">~</span> % <span class="cursor"></span>`,
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Privacy policy — securelayer.co</title>
    <meta
      name="description"
      content="Privacy policy for securelayer.co — what data the site and its demos handle, who processes it, and your rights."
    />
    <link rel="canonical" href="https://securelayer.co/privacy" />
    <style>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        background: #1c1330;
        color: #d8d8d8;
        font-family: "JetBrains Mono", "Courier New", monospace;
        font-size: 13px;
        line-height: 1.7;
        min-height: 100vh;
      }

      .legal-bg {
        position: fixed;
        inset: -40px;
        z-index: -2;
        background: url("/images/terminal-bg.webp") center / cover no-repeat;
        filter: blur(38px) saturate(1.1) brightness(0.5);
        transform: scale(1.08);
      }
      .legal-scrim {
        position: fixed;
        inset: 0;
        z-index: -1;
        background: rgba(15, 10, 25, 0.78);
      }

      /* every inline element below (a, strong, .heading, .user, .path, .cmdtext, .comment,
       .cursor, .placeholder) lives inside content injected via set:html — it never gets
       Astro's data-astro-cid scoping attribute, so all of these MUST use :global(),
       or the rule silently never matches (same bug hit before on this project's
       set:html-injected homepage logo mark). Structural wrapper classes (.dline, .added,
       .cmd, .lc, .ln, .mark, .listing-row) are normal Astro template attributes, not
       injected, so they scope normally and don't need :global(). */
      :global(a) {
        color: #5eead4;
        text-decoration: underline;
      }
      :global(a:hover) {
        text-decoration: underline;
      }

      .term-window {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      .term-titlebar {
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        background: #2b2440;
        padding: 9px 16px;
        border-bottom: 1px solid #150f24;
      }
      .traffic-lights {
        display: flex;
        gap: 8px;
        position: absolute;
        left: 16px;
      }
      .tl {
        width: 12px;
        height: 12px;
        border-radius: 50%;
      }
      .tl.red {
        background: #ff5f57;
      }
      .tl.yellow {
        background: #febc2e;
      }
      .tl.green {
        background: #28c840;
      }
      .term-title {
        font-size: 12.5px;
        color: #9d93b8;
      }

      /* ── diff-viewer body: numbered gutter + "added" highlight rows ── */
      .diff-body {
        flex: 1;
        max-width: 900px;
        width: 100%;
        margin: 0 auto;
        padding: 12px 0 60px;
        overflow-x: auto;
      }

      .dline {
        display: grid;
        grid-template-columns: 44px 18px 1fr;
        column-gap: 10px;
        padding: 2px 20px;
      }
      .dline .ln {
        color: #9089ab;
        text-align: right;
        user-select: none;
      }
      .dline .mark {
        color: #2dd4bf;
        font-weight: 700;
      }
      .dline .lc {
        color: #c6c0d9;
      }

      .dline.added {
        background: rgba(13, 148, 136, 0.22);
      }
      .dline.added .ln {
        color: #5eead4;
      }
      .dline.added .lc {
        color: #e8fdfa;
      }

      .dline.cmd :global(.user) {
        color: #34d399;
        font-weight: 700;
      }
      .dline.cmd :global(.path) {
        color: #7dd3fc;
      }
      .dline.cmd :global(.cmdtext) {
        color: #f0f0f0;
      }

      :global(.heading) {
        color: #2dd4bf;
        font-weight: 700;
      }
      :global(.heading::before) {
        content: "# ";
        opacity: 0.6;
      }
      .added :global(.heading) {
        color: #99f6e4;
      }

      :global(strong) {
        color: #fff;
        font-weight: 700;
      }
      :global(.placeholder) {
        color: #f59e0b;
        background: rgba(245, 158, 11, 0.14);
        padding: 0 4px;
        border-radius: 2px;
      }
      :global(.comment) {
        color: #948da8;
        font-style: italic;
      }
      .listing-row .lc {
        color: #7dd3fc;
      }

      :global(.cursor) {
        display: inline-block;
        width: 7px;
        height: 14px;
        background: #34d399;
        vertical-align: middle;
        animation: blink 1s step-end infinite;
      }
      @keyframes blink {
        50% {
          opacity: 0;
        }
      }

      @media (max-width: 560px) {
        .dline {
          grid-template-columns: 28px 14px 1fr;
          column-gap: 6px;
          padding: 2px 12px;
          font-size: 12px;
        }
      }
    </style>
  </head>
  <body>
    <div class="legal-bg" aria-hidden="true"></div>
    <div class="legal-scrim" aria-hidden="true"></div>
    <div class="term-window" role="main">
      <div class="term-titlebar">
        <div class="traffic-lights">
          <span class="tl red"></span>
          <span class="tl yellow"></span>
          <span class="tl green"></span>
        </div>
        <span class="term-title">securelayer — privacy.diff</span>
      </div>

      <div class="diff-body">
        {rows.map((r, i) => (
          <div
            class={`dline${r.added ? " added" : ""}${r.cls ? " " + r.cls : ""}`}
          >
            <span class="ln">{r.html ? i + 1 : ""}</span>
            <span class="mark">{r.added ? "+" : ""}</span>
            <span class="lc" set:html={r.html} />
          </div>
        ))}
      </div>
    </div>
  </body>
</html>
