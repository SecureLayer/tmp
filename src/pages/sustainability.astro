<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sustainability — securelayer.co</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background: #0a0f0f;
      color: #e0e0e0;
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 14px;
      line-height: 1.6;
      min-height: 100vh;
    }

    .page { max-width: 1240px; margin: 0 auto; padding: 40px 24px 80px; }

    a { color: inherit; text-decoration: none; }
    a:hover { text-decoration: underline; }

    .section-title { font-size: 13px; font-weight: 700; color: #888; letter-spacing: 0.8px; text-transform: uppercase; margin-bottom: 16px; }

    .pipeline-card { background: #0d1a1a; border: 1px solid #1a3030; border-radius: 8px; padding: 24px; margin-bottom: 48px; }
    .pipeline-checks { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; }
    .check-item { display: flex; align-items: flex-start; gap: 10px; }
    .check-icon { color: #4ade80; font-size: 14px; font-weight: 800; flex-shrink: 0; margin-top: 2px; }
    .check-label strong { color: #e0e0e0; font-size: 12px; font-weight: 700; display: block; margin-bottom: 3px; }
    .check-label .check-desc { font-size: 11px; color: #555; line-height: 1.5; }

    /* ── Browser chrome (Firefox) ── */
    .browser-window { min-height: 100vh; display: flex; flex-direction: column; }

    .browser-titlebar {
      display: flex; align-items: center; gap: 14px;
      background: #1c1b22; padding: 10px 16px 0;
      border-bottom: 1px solid #2f2e38;
    }
    .traffic-lights { display: flex; gap: 8px; padding-bottom: 10px; flex-shrink: 0; }
    .tl { width: 12px; height: 12px; border-radius: 50%; }
    .tl.red { background: #ff5f57; }
    .tl.yellow { background: #febc2e; }
    .tl.green { background: #28c840; }

    .browser-tab {
      display: flex; align-items: center; gap: 8px;
      background: #2b2a33; border-radius: 8px 8px 0 0;
      padding: 8px 12px; max-width: 260px;
    }
    .tab-favicon { width: 15px; height: 15px; flex-shrink: 0; }
    .tab-title { font-size: 12.5px; color: #e8e6ee; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .tab-close { margin-left: auto; color: #8a8794; font-size: 15px; line-height: 1; flex-shrink: 0; }
    .tab-add { color: #8a8794; font-size: 18px; padding: 0 10px 10px; line-height: 1; align-self: center; }
    .tab-chevron { color: #8a8794; font-size: 11px; padding-bottom: 10px; align-self: center; }

    .private-badge {
      margin-left: auto; display: flex; align-items: center; gap: 6px;
      color: #c689ff; font-size: 12px; padding-bottom: 10px; white-space: nowrap;
    }
    .private-badge svg { width: 15px; height: 15px; }

    .browser-navbar {
      display: flex; align-items: center; gap: 12px;
      background: #2b2a33; padding: 10px 16px;
      border-bottom: 1px solid #2f2e38;
    }
    .nav-icon { color: #9d9aa8; flex-shrink: 0; display: flex; align-items: center; }
    .nav-icon svg { width: 17px; height: 17px; }
    .nav-icon.disabled { color: #514f5c; }
    .address-pill {
      flex: 1; display: flex; align-items: center; gap: 8px;
      background: #42414d; border-radius: 7px; padding: 7px 14px;
      max-width: 640px; margin: 0 auto;
    }
    .address-pill svg { width: 14px; height: 14px; color: #9d9aa8; flex-shrink: 0; }
    .addr-text { font-size: 13px; color: #e8e6ee; flex: 1; }
    .addr-path { color: #9d9aa8; }
    .addr-star { margin-left: auto; }
    .vpn-badge {
      display: flex; align-items: center; gap: 5px;
      background: rgba(255,95,87,.12); border: 1px solid rgba(255,95,87,.35);
      color: #ff8a80; font-size: 11px; font-weight: 700; letter-spacing: .04em;
      padding: 4px 9px; border-radius: 5px; flex-shrink: 0;
    }
    .vpn-badge svg { width: 11px; height: 11px; }
    .nav-fox { width: 20px; height: 20px; flex-shrink: 0; }
    .nav-menu svg { width: 18px; height: 18px; }

    .browser-body { flex: 1; }

    /* ── free-prompts-style hero ── */
    .page-hero { max-width: 640px; margin: 0 auto; padding: 8px 24px 40px; text-align: center; }
    .hero-badge {
      display: inline-flex; align-items: center; gap: 8px;
      background: rgba(74,222,128,.1); border: 1px solid rgba(74,222,128,.2);
      color: #4ade80; font-size: .7rem; font-weight: 600;
      letter-spacing: .08em; text-transform: uppercase;
      padding: 5px 14px; border-radius: 100px; margin-bottom: 20px;
    }
    .badge-dot { width: 6px; height: 6px; background: #4ade80; border-radius: 50%; }
    .page-hero h1 { font-size: clamp(1.4rem, 3.4vw, 2rem); font-weight: 700; color: #fff; margin-bottom: 10px; }
    .page-hero p { color: #999; font-size: .875rem; margin-bottom: 16px; line-height: 1.6; }
    .hero-meta { font-size: .78rem; color: #888; }
    .hero-meta .sep { margin: 0 6px; opacity: .4; }
    .hero-meta strong { color: #4ade80; }

    /* ── score-card pattern (matches security.astro) ── */
    .scores-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 16px;
      margin-bottom: 48px;
    }
    .score-card {
      background: #0d1a1a; border: 1px solid #1a3030; border-radius: 8px;
      padding: 24px; color: inherit; display: flex; flex-direction: column; gap: 16px;
    }
    .card-header { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
    .service-name { font-size: 13px; font-weight: 700; color: #aaa; letter-spacing: 0.3px; }
    .grade-badge { font-size: 22px; font-weight: 800; padding: 4px 12px; border-radius: 6px; line-height: 1.4; flex-shrink: 0; }
    .grade-Aplus { color: #4ade80; background: #0d2a0d; border: 1px solid #166534; }
    .grade-safe  { color: #5eead4; background: #0d2a2a; border: 1px solid #0d9488; font-size: 13px; }
    .card-desc { font-size: 12px; color: #555; line-height: 1.5; }
    .card-link { font-size: 11px; color: #0d9488; letter-spacing: 0.3px; }

    /* ── Mobile: drop the icon row, keep tab + address pill only ── */
    @media (max-width: 640px) {
      .browser-tab { max-width: 140px; }
      .tab-add, .tab-chevron { display: none; }
      .nav-icon, .nav-divider, .nav-brave, .nav-fox, .nav-menu, .vpn-badge, .private-badge { display: none; }
      .address-pill { max-width: none; margin: 0; }
    }

    /* ── Footer ── */
    .site-footer { border-top: 1px solid #1a3030; padding: 40px 24px; text-align: center; margin-top: 24px; }
    .site-footer p { color: #888; font-size: 13px; }
    .footer-links { margin-top: 14px; display: flex; justify-content: center; gap: 20px; }
    .footer-links a { font-size: 12px; color: #888; text-decoration: none; }
    .footer-links a:hover { color: #5eead4; }
    .footer-green-link { display: inline-block; margin-top: 18px; opacity: .85; transition: opacity .2s; }
    .footer-green-link:hover { opacity: 1; }
    .footer-green-link img { display: block; width: 100px; height: auto; margin: 0 auto; }
    .footer-copy { margin-top: 12px; font-size: 11px; }
  </style>
</head>
<body>
<div class="browser-window">
  <div class="browser-titlebar">
    <div class="traffic-lights">
      <span class="tl red"></span><span class="tl yellow"></span><span class="tl green"></span>
    </div>
    <div class="browser-tab">
      <img class="tab-favicon" src="/favicon.svg" alt="" />
      <span class="tab-title">Sustainability — securelayer.co</span>
      <span class="tab-close">&times;</span>
    </div>
    <span class="tab-add">+</span>
    <span class="tab-chevron">&#9660;</span>
    <span class="private-badge">
      <svg viewBox="0 0 24 24" fill="none"><path d="M8 12a4 4 0 1 1 4 4c-1.5 0-2.5-1-4-1s-2.5 1-4 1a4 4 0 1 1 4-4Zm8 0a4 4 0 1 0 4 4c-1.5 0-2.5-1-4-1s-2.5 1-4 1a4 4 0 1 0 4-4Z" stroke="currentColor" stroke-width="1.6"/></svg>
      Private browsing
    </span>
  </div>
  <div class="browser-navbar">
    <span class="nav-icon nav-sidebar"><svg viewBox="0 0 24 24" fill="none"><rect x="3" y="4" width="18" height="16" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M9 4v16" stroke="currentColor" stroke-width="1.6"/></svg></span>
    <span class="nav-icon nav-back"><svg viewBox="0 0 24 24" fill="none"><path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
    <span class="nav-icon nav-forward disabled"><svg viewBox="0 0 24 24" fill="none"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
    <span class="nav-icon nav-reload"><svg viewBox="0 0 24 24" fill="none"><path d="M4 12a8 8 0 0 1 14-5.3M20 12a8 8 0 0 1-14 5.3M4 4v5h5M20 20v-5h-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
    <div class="address-pill">
      <svg viewBox="0 0 24 24" fill="none"><path d="M12 3l7 3v5c0 4.6-3 7.9-7 9-4-1.1-7-4.4-7-9V6l7-3Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="m9.5 12 1.8 1.8L15 10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <span class="addr-text">securelayer.co<span class="addr-path">/sustainability/</span></span>
      <span class="addr-star"><svg viewBox="0 0 24 24" fill="none"><path d="m12 3 2.7 5.9 6.3.7-4.7 4.4 1.3 6.3L12 17.2l-5.6 3.1 1.3-6.3-4.7-4.4 6.3-.7L12 3Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg></span>
    </div>
    <span class="vpn-badge"><svg viewBox="0 0 24 24" fill="none"><path d="M18 6 6 18M6 6l12 12" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>VPN</span>
    <span class="nav-icon nav-profile"><svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="8" r="3.3" stroke="currentColor" stroke-width="1.6"/><path d="M5 20c1.3-3.4 4-5 7-5s5.7 1.6 7 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg></span>
    <span class="nav-icon nav-ext"><svg viewBox="0 0 24 24" fill="none"><path d="M9 3h6v3.5a2 2 0 0 0 2 2H21v6h-3.5a2 2 0 0 0-2 2V21H9v-3.5a2 2 0 0 0-2-2H3v-6h3.5a2 2 0 0 0 2-2V3Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg></span>
    <img class="nav-fox" src="/images/dock-icons/firefox.png" alt="Firefox" />
    <span class="nav-menu"><svg viewBox="0 0 24 24" fill="none"><path d="M4 6h16M4 12h16M4 18h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></span>
  </div>
  <div class="browser-body">
<div class="page">

  <div class="page-hero">
    <div class="hero-badge">
      <span class="badge-dot"></span>
      Green Hosting · Low Carbon · Verified
    </div>
    <h1>Green by design</h1>
    <p>SecureLayer is a static site served from Cloudflare's CDN — no origin server, no database, minimal compute per visitor. Here is what the numbers say.</p>
    <div class="hero-meta"><span>3</span> assessments <span class="sep">·</span> <strong>All verified</strong></div>
  </div>

  <div class="scores-grid">

    <div class="score-card">
      <div class="card-header">
        <span class="service-name">Digital Beacon<br>Carbon Report</span>
        <span class="grade-badge grade-Aplus">A+</span>
      </div>
      <p class="card-desc">0.044g CO₂ first visit, 0.003g return · 143 KB page weight · 0ms server response.</p>
      <a class="card-link" href="https://digitalbeacon.co/report/securelayer-co" target="_blank" rel="noopener noreferrer">View full report ↗</a>
    </div>

    <div class="score-card">
      <div class="card-header">
        <span class="service-name">Website Carbon<br>Calculator</span>
        <span class="grade-badge grade-Aplus">A+</span>
      </div>
      <p class="card-desc">Top 3% globally — cleaner than 97% of pages tested.</p>
      <a class="card-link" href="https://www.websitecarbon.com/website/securelayer-co/" target="_blank" rel="noopener noreferrer">View full report ↗</a>
    </div>

    <div class="score-card">
      <div class="card-header">
        <span class="service-name">Green Web<br>Foundation</span>
        <span class="grade-badge grade-safe">Verified</span>
      </div>
      <p class="card-desc">Served via Cloudflare CDN — renewable energy certified, zero origin compute per visit.</p>
      <a class="card-link" href="https://www.thegreenwebfoundation.org/green-web-check/?url=securelayer.co" target="_blank" rel="noopener noreferrer">View full report ↗</a>
    </div>

  </div>

  <p class="section-title">Why it's low</p>
  <div class="pipeline-card">
    <div class="pipeline-checks">

      <div class="check-item">
        <span class="check-icon">✓</span>
        <span class="check-label">
          <strong>Static architecture</strong>
          <span class="check-desc">The entire site is pre-built HTML/CSS/JS. No server runs when you visit — pages are served cold from Cloudflare's global edge network.</span>
        </span>
      </div>

      <div class="check-item">
        <span class="check-icon">✓</span>
        <span class="check-label">
          <strong>Pre-computed data</strong>
          <span class="check-desc">Security assessments are computed once weekly by a local scanner and stored in R2. Your browser fetches a single JSON file — no live GitHub API calls, no chained requests.</span>
        </span>
      </div>

      <div class="check-item">
        <span class="check-icon">✓</span>
        <span class="check-label">
          <strong>No tracking, no analytics</strong>
          <span class="check-desc">Zero tracking pixels, no analytics scripts, no third-party calls beyond Google Fonts. Less data transferred means less energy consumed per visit.</span>
        </span>
      </div>

      <div class="check-item">
        <span class="check-icon">✓</span>
        <span class="check-label">
          <strong>Green CDN</strong>
          <span class="check-desc">Cloudflare is Green Web Foundation certified — the infrastructure that delivers every page runs on renewable energy.</span>
        </span>
      </div>

    </div>
  </div>

  <footer class="site-footer">
    <p>Choose cybersecurity, it's cheaper.</p>
    <p class="footer-links">
      <a href="/">Home</a>
      <a href="/security">Security</a>
      <a href="/sustainability">Environment</a>
    </p>
    <a href="/sustainability" class="footer-green-link">
      <img src="/gwf-badge.png" alt="This website runs on green hosting - verified by thegreenwebfoundation.org" />
    </a>
    <p class="footer-copy">&copy; 2026 SecureLayer. All rights reserved.</p>
  </footer>

</div>
  </div>
</div>
</body>
</html>
