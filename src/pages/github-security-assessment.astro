---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="GitHub Security Assessment — SecureLayer"
  description="Pre-audited open-source repositories scored across 6 security checks. See which tools are safe to install — updated weekly."
>
  <main>

    <div class="assess-hero">
      <div class="section-label">Security Intelligence</div>
      <h1>Repository Security <span>Assessments</span></h1>
      <p class="assess-hero-sub">
        We audit popular open-source repos across 6 security checks before you install them.
        Scores are pre-computed — no live API calls, no rate limits.
      </p>
    </div>

    <!-- Grade groups rendered by JS -->
    <section class="assess-wrap">
      <div id="assess-status" class="assess-status">Loading assessments…</div>
      <div id="assess-body" style="display:none"></div>
    </section>

    <!-- Vote for next -->
    <section class="vote-wrap" id="vote-wrap" style="display:none">
      <h2>Vote for the next assessment</h2>
      <p class="vote-desc">Which repo should we audit next? One vote per day — we scan the top-voted repo weekly and publish the full report.</p>
      <div id="vote-list" class="vote-list"></div>
    </section>

    <p class="assess-note">ⓘ Scores are pre-computed weekly using the GitHub public API. Branch protection and secret scanning require admin access and are not included.</p>

  </main>
</Layout>

<style is:global>
  /* ── Hero ── */
  .assess-hero {
    max-width: 800px;
    margin: 0 auto;
    padding: 120px 24px 48px;
    text-align: center;
  }
  .assess-hero h1 {
    font-family: var(--font-head);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    color: var(--white);
    line-height: 1.15;
    margin-bottom: 16px;
  }
  .assess-hero h1 span { color: var(--cyan); }
  .assess-hero-sub {
    color: var(--muted);
    font-size: .9375rem;
    max-width: 560px;
    margin: 0 auto;
    line-height: 1.6;
  }

  /* ── Layout ── */
  .assess-wrap  { max-width: 860px; margin: 0 auto; padding: 0 24px 48px; }
  .assess-status { color: var(--muted); font-size: .875rem; text-align: center; padding: 48px 0; }

  /* ── Grade group ── */
  .grade-group { margin-bottom: 36px; }
  .grade-group-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--border);
  }
  .grade-letter {
    font-family: var(--font-head);
    font-size: 1.1rem;
    font-weight: 700;
    width: 26px;
    height: 26px;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .grade-label { font-size: .8125rem; font-weight: 600; color: var(--muted); }
  .grade-count {
    font-size: .7rem;
    font-family: var(--font-mono);
    color: var(--muted);
    background: var(--bg2);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1px 7px;
    margin-left: auto;
  }

  .grade-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 6px;
  }
  @media (max-width: 600px) { .grade-grid { grid-template-columns: 1fr; } }

  /* ── Compact cards ── */
  .assess-card {
    background: var(--bg2);
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
    cursor: pointer;
    transition: border-color .15s;
  }
  .assess-card:hover   { border-color: rgba(167,139,250,.3); }
  .assess-card.expanded { border-color: var(--cyan-dim); }

  .card-header {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
  }
  .card-main  { flex: 1; min-width: 0; }
  .card-repo  {
    font-family: var(--font-head);
    font-size: .8125rem;
    font-weight: 700;
    color: var(--cyan);
    text-decoration: none;
    display: block;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .card-repo:hover { text-decoration: underline; }

  .card-chips-row { display: flex; flex-wrap: wrap; gap: 4px; margin-top: 4px; }
  .card-chip {
    font-size: .65rem;
    color: var(--muted);
    background: var(--bg3);
    border: 1px solid var(--border);
    border-radius: 3px;
    padding: 1px 5px;
  }

  .card-right { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }
  .card-dots  { display: flex; gap: 3px; }
  .card-dot   { width: 7px; height: 7px; border-radius: 50%; }
  .card-score-val {
    font-family: var(--font-mono);
    font-size: .7rem;
    color: var(--muted);
    white-space: nowrap;
  }
  .card-expand { font-size: .7rem; color: var(--muted); }

  /* ── Expanded details ── */
  .card-details { border-top: 1px solid var(--border); }
  .card-desc-row {
    font-size: .75rem;
    color: var(--muted);
    padding: 8px 14px;
    border-bottom: 1px solid var(--border);
    line-height: 1.5;
  }
  .check-row-sm {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 7px 14px;
    border-bottom: 1px solid var(--border);
    font-size: .75rem;
  }
  .check-row-sm:last-child { border-bottom: none; }
  .check-icon-sm { font-size: .8rem; min-width: 14px; }
  .check-row-sm.pass .check-icon-sm { color: #22c55e; }
  .check-row-sm.fail .check-icon-sm { color: #f87171; }
  .check-row-sm.warn .check-icon-sm { color: #f59e0b; }
  .check-name-sm { flex: 1; color: var(--text); }
  .check-row-sm.fail .check-name-sm { color: var(--muted); }
  .check-pts { font-family: var(--font-mono); font-size: .7rem; color: var(--muted); white-space: nowrap; }

  /* ── Vote ── */
  .vote-wrap  { max-width: 860px; margin: 0 auto; padding: 40px 24px 64px; border-top: 1px solid var(--border); }
  .vote-wrap h2 { font-size: 1.125rem; color: var(--white); font-family: var(--font-head); font-weight: 700; margin-bottom: 6px; }
  .vote-desc  { color: var(--muted); font-size: .875rem; margin-bottom: 20px; }
  .vote-list  { display: flex; flex-direction: column; gap: 6px; }

  .vote-row { display: flex; align-items: center; gap: 12px; background: var(--bg2); border: 1px solid var(--border); border-radius: 8px; padding: 10px 14px; }
  .vote-info { flex: 1; min-width: 0; }
  .vote-repo { font-family: var(--font-head); font-size: .8125rem; font-weight: 700; color: var(--text); }
  .vote-repo-desc { font-size: .7rem; color: var(--muted); margin-top: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .vote-stars { font-size: .7rem; color: var(--muted); white-space: nowrap; flex-shrink: 0; }
  .vote-count { font-family: var(--font-mono); font-size: .75rem; color: var(--muted); white-space: nowrap; min-width: 52px; text-align: right; flex-shrink: 0; }
  .vote-btn { background: none; border: 1px solid var(--border2); border-radius: 6px; color: var(--text); font-size: .75rem; font-family: var(--font-head); font-weight: 700; padding: 5px 12px; cursor: pointer; transition: border-color .15s, color .15s; white-space: nowrap; flex-shrink: 0; }
  .vote-btn:hover:not(:disabled) { border-color: var(--cyan); color: var(--cyan); }
  .vote-btn:disabled { opacity: .5; cursor: default; }
  .vote-btn.voted { border-color: #22c55e; color: #22c55e; }

  /* ── Note ── */
  .assess-note { max-width: 860px; margin: 0 auto; padding: 0 24px 64px; color: var(--muted); font-size: .7rem; }
</style>

<script>
  const CHECKS = [
    { id: 'security_policy', name: 'Security Policy (SECURITY.md)',    weight: 20 },
    { id: 'dependabot',      name: 'Automated Dependency Updates',     weight: 25 },
    { id: 'ci_cd',           name: 'CI/CD Pipeline (GitHub Actions)',  weight: 20 },
    { id: 'active',          name: 'Active Maintenance (< 12 months)', weight: 20 },
    { id: 'license',         name: 'Open Source License',              weight: 10 },
    { id: 'not_archived',    name: 'Repository Not Archived',          weight: 5  },
  ];

  const GRADES: Record<string, { label: string; color: string; bg: string }> = {
    A: { label: 'Excellent',      color: '#22c55e', bg: 'rgba(34,197,94,.12)'  },
    B: { label: 'Good',           color: '#86efac', bg: 'rgba(134,239,172,.1)' },
    C: { label: 'Fair',           color: '#f59e0b', bg: 'rgba(245,158,11,.1)'  },
    D: { label: 'Poor',           color: '#fb923c', bg: 'rgba(251,146,60,.1)'  },
    F: { label: 'Critical Gaps',  color: '#f87171', bg: 'rgba(248,113,113,.1)' },
  };

  function fmtStars(n: number) { return n >= 1000 ? (n / 1000).toFixed(1) + 'k' : String(n); }

  function renderCard(a: any) {
    const card = document.createElement('div');
    card.className = 'assess-card';

    const header = document.createElement('div');
    header.className = 'card-header';

    const main = document.createElement('div');
    main.className = 'card-main';

    const link = document.createElement('a');
    link.className = 'card-repo';
    link.href = 'https://github.com/' + a.repo;
    link.target = '_blank';
    link.rel = 'noopener noreferrer';
    link.textContent = a.repo;
    link.addEventListener('click', e => e.stopPropagation());

    const chipsRow = document.createElement('div');
    chipsRow.className = 'card-chips-row';
    ['★ ' + fmtStars(a.stars), a.language, 'assessed ' + (a.assessed_at ?? '').slice(0, 7)]
      .filter(Boolean)
      .forEach(t => {
        const chip = document.createElement('span');
        chip.className = 'card-chip';
        chip.textContent = t;
        chipsRow.appendChild(chip);
      });

    main.append(link, chipsRow);

    const right = document.createElement('div');
    right.className = 'card-right';

    const dots = document.createElement('div');
    dots.className = 'card-dots';
    CHECKS.forEach(c => {
      const dot = document.createElement('div');
      dot.className = 'card-dot';
      dot.style.background = a.checks[c.id] ? '#22c55e' : '#f87171';
      dot.title = c.name + ': ' + (a.checks[c.id] ? 'pass' : 'fail');
      dots.appendChild(dot);
    });

    const scoreEl = document.createElement('div');
    scoreEl.className = 'card-score-val';
    scoreEl.textContent = a.score + '/100';

    const expandEl = document.createElement('div');
    expandEl.className = 'card-expand';
    expandEl.textContent = '▾';

    right.append(dots, scoreEl, expandEl);
    header.append(main, right);

    /* details */
    const details = document.createElement('div');
    details.className = 'card-details';
    details.style.display = 'none';

    if (a.description) {
      const descRow = document.createElement('div');
      descRow.className = 'card-desc-row';
      descRow.textContent = a.description;
      details.appendChild(descRow);
    }

    CHECKS.forEach(c => {
      const pass  = a.checks[c.id];
      const level = pass ? 'pass' : (c.id === 'license' ? 'warn' : 'fail');
      const row   = document.createElement('div');
      row.className = 'check-row-sm ' + level;

      const icon = document.createElement('div');
      icon.className = 'check-icon-sm';
      icon.textContent = pass ? '✓' : '✕';

      const name = document.createElement('div');
      name.className = 'check-name-sm';
      name.textContent = c.name;

      const pts = document.createElement('div');
      pts.className = 'check-pts';
      pts.textContent = (pass ? c.weight : 0) + '/' + c.weight + ' pts';

      row.append(icon, name, pts);
      details.appendChild(row);
    });

    header.addEventListener('click', () => {
      const open = details.style.display !== 'none';
      details.style.display = open ? 'none' : 'block';
      expandEl.textContent  = open ? '▾' : '▴';
      card.classList.toggle('expanded', !open);
    });

    card.append(header, details);
    return card;
  }

  function renderGradeGroup(grade: string, repos: any[]) {
    const meta = GRADES[grade];
    const group = document.createElement('div');
    group.className = 'grade-group';

    const hdr = document.createElement('div');
    hdr.className = 'grade-group-header';

    const letter = document.createElement('div');
    letter.className = 'grade-letter';
    letter.style.color = meta.color;
    letter.style.background = meta.bg;
    letter.textContent = grade;

    const label = document.createElement('div');
    label.className = 'grade-label';
    label.textContent = meta.label;

    const count = document.createElement('div');
    count.className = 'grade-count';
    count.textContent = repos.length + ' repo' + (repos.length !== 1 ? 's' : '');

    hdr.append(letter, label, count);

    const grid = document.createElement('div');
    grid.className = 'grade-grid';
    repos.forEach(a => grid.appendChild(renderCard(a)));

    group.append(hdr, grid);
    return group;
  }

  function renderVoteRow(c: any, onVote: (repo: string, btn: HTMLButtonElement, countEl: HTMLElement) => void) {
    const row = document.createElement('div');
    row.className = 'vote-row';

    const info = document.createElement('div');
    info.className = 'vote-info';
    const name = document.createElement('div');
    name.className = 'vote-repo';
    name.textContent = c.repo;
    const desc = document.createElement('div');
    desc.className = 'vote-repo-desc';
    desc.textContent = c.desc;
    info.append(name, desc);

    const stars = document.createElement('div');
    stars.className = 'vote-stars';
    stars.textContent = '★ ' + fmtStars(c.stars);

    const countEl = document.createElement('div');
    countEl.className = 'vote-count';
    countEl.textContent = c.votes + (c.votes === 1 ? ' vote' : ' votes');

    const btn = document.createElement('button');
    btn.className = 'vote-btn';
    btn.textContent = 'Vote ↑';
    btn.addEventListener('click', () => onVote(c.repo, btn, countEl));

    row.append(info, stars, countEl, btn);
    return row;
  }

  async function init() {
    const statusEl = document.getElementById('assess-status')!;
    const bodyEl   = document.getElementById('assess-body')!;

    try {
      const res = await fetch('/api/assessments');
      if (res.status === 404) { statusEl.textContent = 'No assessments published yet — check back soon.'; return; }
      if (!res.ok) throw new Error();
      const data: any[] = await res.json();

      /* group by grade in A→F order */
      const groups: Record<string, any[]> = { A: [], B: [], C: [], D: [], F: [] };
      data.forEach(a => { if (groups[a.grade]) groups[a.grade].push(a); });

      bodyEl.textContent = '';
      Object.entries(groups).forEach(([grade, repos]) => {
        if (repos.length) bodyEl.appendChild(renderGradeGroup(grade, repos));
      });

      statusEl.style.display = 'none';
      bodyEl.style.display   = 'block';
    } catch {
      statusEl.textContent = 'Assessments temporarily unavailable.';
    }

    try {
      const res = await fetch('/api/vote/candidates');
      if (!res.ok) return;
      const candidates: any[] = await res.json();
      const listEl = document.getElementById('vote-list')!;
      const wrapEl = document.getElementById('vote-wrap')!;
      candidates.forEach(c => {
        listEl.appendChild(renderVoteRow(c, async (repo, btn, countEl) => {
          btn.disabled = true;
          btn.textContent = '…';
          try {
            const r    = await fetch('/api/vote', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ repo }) });
            const body = await r.json();
            if (r.status === 429 || body.alreadyVoted) {
              btn.textContent = 'Voted ✓'; btn.className = 'vote-btn voted';
            } else if (r.ok) {
              btn.textContent = 'Voted ✓'; btn.className = 'vote-btn voted';
              countEl.textContent = body.votes + (body.votes === 1 ? ' vote' : ' votes');
            } else {
              btn.textContent = 'Vote ↑'; btn.disabled = false;
            }
          } catch {
            btn.textContent = 'Vote ↑'; btn.disabled = false;
          }
        }));
      });
      wrapEl.style.display = 'block';
    } catch { /* vote section stays hidden */ }
  }

  init();
</script>
