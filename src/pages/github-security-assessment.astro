---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="GitHub Security Assessment — SecureLayer"
  description="Pre-audited open-source repositories scored across 6 security checks. See which tools are safe to install — updated weekly."
>
  <main>

    <div class="assess-hero">
      <div class="section-label">Security Intelligence</div>
      <h1>Repository Security <span>Assessments</span></h1>
      <p class="assess-hero-sub">
        We audit popular open-source repos across 8 security checks before you install them.
        Scores are pre-computed — no live API calls, no rate limits.
      </p>
    </div>

    <!-- Grade groups rendered by JS -->
    <section class="assess-wrap">
      <div id="assess-status" class="assess-status">Loading assessments…</div>
      <div id="assess-body" class="assess-body-hidden"></div>
    </section>

    <!-- Live scan CTA -->
    <section class="livescan-cta">
      <div class="livescan-inner">
        <div class="livescan-text">
          <div class="livescan-eyebrow">Coming soon</div>
          <h2>Want to scan your own repo?</h2>
          <p>Live scanning with GitHub OAuth is in our roadmap. Vote to tell us you want it — we'll build it when we hit our milestone.</p>
        </div>
        <a href="https://github.securelayer.co" class="livescan-btn" target="_blank" rel="noopener">Vote to build this →</a>
      </div>
    </section>

    <p class="assess-note">ⓘ Scores pre-computed weekly using the GitHub API and OpenSSF Scorecard. A–B grades are shown individually. C through F repos are grouped under "Below Security Baseline" — specific gap details are kept private to avoid creating a targeted attack surface. An active security incident deducts 10 pts from the base score.</p>

  </main>
</Layout>

<style is:global>
  /* ── Hero ── */
  .assess-hero {
    max-width: 800px;
    margin: 0 auto;
    padding: 120px 24px 48px;
    text-align: center;
  }
  .assess-hero h1 {
    font-family: var(--font-head);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    color: var(--white);
    line-height: 1.15;
    margin-bottom: 16px;
  }
  .assess-hero h1 span { color: var(--cyan); }
  .assess-hero-sub {
    color: var(--muted);
    font-size: .9375rem;
    max-width: 560px;
    margin: 0 auto;
    line-height: 1.6;
  }

  /* ── Layout ── */
  .assess-wrap  { max-width: 860px; margin: 0 auto; padding: 0 24px 48px; }
  .assess-body-hidden { display: none; }
  .assess-status { color: var(--muted); font-size: .875rem; text-align: center; padding: 48px 0; }

  /* ── Grade group ── */
  .grade-group { margin-bottom: 36px; }
  .grade-group-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--border);
  }
  .grade-letter {
    font-family: var(--font-head);
    font-size: .875rem;
    font-weight: 700;
    min-width: 34px;
    height: 26px;
    border-radius: 6px;
    padding: 0 5px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    letter-spacing: -.5px;
  }
  .grade-label { font-size: .8125rem; font-weight: 600; color: var(--muted); }
  .grade-count {
    font-size: .7rem;
    font-family: var(--font-mono);
    color: var(--muted);
    background: var(--bg2);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1px 7px;
    margin-left: auto;
  }
  .grade-letter-below {
    color: #6b7280;
    background: rgba(107,114,128,.12);
    font-size: .75rem;
    letter-spacing: -.25px;
  }

  .grade-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 6px;
  }
  @media (max-width: 600px) { .grade-grid { grid-template-columns: 1fr; } }

  /* ── Compact cards ── */
  .assess-card {
    background: var(--bg2);
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
    cursor: pointer;
    transition: border-color .15s;
  }
  .assess-card:hover   { border-color: rgba(167,139,250,.3); }
  .assess-card.expanded { border-color: var(--cyan-dim); }

  .card-header {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
  }
  .card-main  { flex: 1; min-width: 0; }
  .card-repo  {
    font-family: var(--font-head);
    font-size: .8125rem;
    font-weight: 700;
    color: var(--cyan);
    text-decoration: none;
    display: block;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .card-repo:hover { text-decoration: underline; }

  .card-chips-row { display: flex; flex-wrap: wrap; gap: 4px; margin-top: 4px; }
  .card-chip {
    font-size: .65rem;
    color: var(--muted);
    background: var(--bg3);
    border: 1px solid var(--border);
    border-radius: 3px;
    padding: 1px 5px;
  }

  .card-expand { font-size: .7rem; color: var(--muted); flex-shrink: 0; }

  /* ── Footer bar (always visible) ── */
  .card-footer-bar {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    padding: 8px 14px 10px;
    border-top: 1px solid var(--border);
    gap: 8px;
  }
  .card-date  { font-size: .6rem; color: var(--muted); font-family: var(--font-mono); align-self: flex-end; }
  .card-footer-right { display: flex; flex-direction: column; align-items: flex-end; gap: 4px; }
  .card-dots      { display: flex; gap: 3px; align-items: center; }
  .card-dot       { width: 7px; height: 7px; border-radius: 50%; }
  .card-dot-locked { filter: blur(1.5px); opacity: .45; }
  .card-score-val {
    font-family: var(--font-mono);
    font-size: .7rem;
    color: var(--muted);
    white-space: nowrap;
  }

  /* ── Expanded details ── */
  .card-details { border-top: 1px solid var(--border); }
  .card-desc-row {
    font-size: .75rem;
    color: var(--muted);
    padding: 8px 14px;
    border-bottom: 1px solid var(--border);
    line-height: 1.5;
  }
  .check-row-sm {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 7px 14px;
    border-bottom: 1px solid var(--border);
    font-size: .75rem;
  }
  .check-row-sm:last-child { border-bottom: none; }
  .check-icon-sm { font-size: .8rem; min-width: 14px; }
  .check-row-sm.pass .check-icon-sm { color: #22c55e; }
  .check-row-sm.fail .check-icon-sm { color: #f87171; }
  .check-row-sm.warn .check-icon-sm { color: #f59e0b; }
  .check-name-sm { flex: 1; color: var(--text); }
  .check-row-sm.fail .check-name-sm { color: var(--muted); }
  .check-pts { font-family: var(--font-mono); font-size: .7rem; color: var(--muted); white-space: nowrap; }

  /* ── Live scan CTA ── */
  .livescan-cta { max-width: 860px; margin: 0 auto; padding: 40px 24px 64px; border-top: 1px solid var(--border); }
  .livescan-inner { display: flex; align-items: center; justify-content: space-between; gap: 32px; background: var(--bg2); border: 1px solid var(--border); border-radius: 12px; padding: 28px 32px; }
  .livescan-eyebrow { font-size: .7rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--cyan); margin-bottom: 8px; }
  .livescan-text h2 { font-size: 1rem; font-weight: 700; color: var(--white); font-family: var(--font-head); margin-bottom: 8px; }
  .livescan-text p  { font-size: .8125rem; color: var(--muted); max-width: 480px; line-height: 1.6; }
  .livescan-btn { flex-shrink: 0; background: none; border: 1px solid var(--border2); border-radius: 8px; color: var(--text); font-size: .8125rem; font-family: var(--font-head); font-weight: 700; padding: 10px 20px; text-decoration: none; white-space: nowrap; transition: border-color .15s, color .15s; }
  .livescan-btn:hover { border-color: var(--cyan); color: var(--cyan); }
  @media (max-width: 600px) { .livescan-inner { flex-direction: column; align-items: flex-start; padding: 20px; } }

  /* ── Locked CTA row (D/F expanded details) ── */
  .check-row-locked { background: rgba(251,146,60,.05); border-top: 1px dashed rgba(251,146,60,.25) !important; }
  .check-row-locked .check-name-sm { color: var(--muted); font-style: italic; }
  .locked-cta {
    display: block;
    padding: 9px 14px;
    font-size: .75rem;
    font-weight: 600;
    color: #fb923c;
    text-decoration: none;
    border-top: 1px solid var(--border);
  }
  .locked-cta:hover { text-decoration: underline; }

  /* ── Incident chip + row ── */
  .chip-incident { color: #f87171 !important; border-color: rgba(248,113,113,.35) !important; }
  .incident-row { background: rgba(239,68,68,.06); }
  .incident-row .check-icon-sm { color: #f87171; }
  .incident-row .check-name-sm { color: #fca5a5; font-weight: 600; }
  .incident-pts { color: #f87171 !important; font-weight: 700; }

  /* ── OpenSSF chip + supplementary row (in expanded details) ── */
  .chip-openssf { color: #a78bfa !important; border-color: rgba(167,139,250,.3) !important; }
  .openssf-row .check-icon-sm { color: #a78bfa; }
  .openssf-row .check-name-sm { color: var(--muted); font-style: italic; }
  .openssf-row { border-top: 1px dashed var(--border); }

  /* ── Note ── */
  .assess-note { max-width: 860px; margin: 0 auto; padding: 0 24px 64px; color: var(--muted); font-size: .7rem; }
</style>

<script is:inline src="/scripts/assessment.js"></script>
