---
import { getCollection } from 'astro:content';

const FEATURED_IDS = ['ddos-protection-free', 'securityheaders-a'];
const freePrompts = (await getCollection('prompts', ({ data }) =>
  data.tier === 'free' && data.published !== false && FEATURED_IDS.includes(data.id)
)).sort((a, b) => FEATURED_IDS.indexOf(a.data.id) - FEATURED_IDS.indexOf(b.data.id));
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>AI Prompts to improve Cybersecurity — SecureLayer</title>
  <meta name="description" content="Free tested AI prompts to check and improve your application or website's security. Copy and use in any AI assistant." />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background: #0a0f0f;
      color: #e0e0e0;
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 14px;
      line-height: 1.6;
      min-height: 100vh;
    }

    .page { max-width: 1240px; margin: 0 auto; padding: 40px 24px 0; }

    a { color: inherit; text-decoration: none; }
    a:hover { text-decoration: underline; }

    /* ── Browser chrome (Brave) ── */
    .browser-window { min-height: 100vh; display: flex; flex-direction: column; }

    .browser-titlebar {
      display: flex; align-items: center; gap: 14px;
      background: #170f20; padding: 10px 16px 0;
      border-bottom: 1px solid #2a2038;
    }
    .traffic-lights { display: flex; gap: 8px; padding-bottom: 10px; flex-shrink: 0; }
    .tl { width: 12px; height: 12px; border-radius: 50%; }
    .tl.red { background: #ff5f57; }
    .tl.yellow { background: #febc2e; }
    .tl.green { background: #28c840; }

    .browser-tab {
      display: flex; align-items: center; gap: 8px;
      background: #241a30; border-radius: 8px 8px 0 0;
      padding: 8px 12px; max-width: 260px;
    }
    .tab-favicon { width: 15px; height: 15px; flex-shrink: 0; }
    .tab-title { font-size: 12.5px; color: #e4dcf0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .tab-close { margin-left: auto; color: #7a6f8c; font-size: 15px; line-height: 1; flex-shrink: 0; }
    .tab-add { color: #7a6f8c; font-size: 18px; padding: 0 10px 10px; line-height: 1; align-self: center; }
    .tab-chevron { color: #7a6f8c; font-size: 11px; margin-left: auto; padding-bottom: 10px; align-self: center; }

    .browser-navbar {
      display: flex; align-items: center; gap: 14px;
      background: #1d1428; padding: 10px 16px;
      border-bottom: 1px solid #2a2038;
    }
    .nav-icon { color: #8a7fa0; flex-shrink: 0; display: flex; align-items: center; }
    .nav-icon svg { width: 17px; height: 17px; }
    .nav-icon.disabled { color: #453b56; }
    .address-pill {
      flex: 1; display: flex; align-items: center; gap: 8px;
      background: #2a2038; border-radius: 7px; padding: 7px 14px;
      max-width: 640px; margin: 0 auto;
    }
    .address-pill svg { width: 14px; height: 14px; color: #8a7fa0; flex-shrink: 0; }
    .addr-text { font-size: 13px; color: #e4dcf0; }
    .addr-path { color: #8a7fa0; }
    .nav-divider { width: 1px; height: 20px; background: #362a48; flex-shrink: 0; }
    .nav-brave { width: 20px; height: 20px; flex-shrink: 0; }
    .nav-menu svg { width: 18px; height: 18px; }

    .browser-body { flex: 1; }

    /* ── Hero ── */
    .page-hero { max-width: 640px; margin: 0 auto; padding: 8px 24px 40px; text-align: center; }
    .hero-badge {
      display: inline-flex; align-items: center; gap: 8px;
      background: rgba(74,222,128,.1); border: 1px solid rgba(74,222,128,.2);
      color: #4ade80; font-size: .7rem; font-weight: 600;
      letter-spacing: .08em; text-transform: uppercase;
      padding: 5px 14px; border-radius: 100px; margin-bottom: 20px;
    }
    .badge-dot { width: 6px; height: 6px; background: #4ade80; border-radius: 50%; animation: pulse 2s infinite; }
    @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: .4; } }
    .page-hero h1 { font-size: clamp(1.4rem, 3.4vw, 2rem); font-weight: 700; color: #fff; margin-bottom: 10px; }
    .page-hero p { color: #999; font-size: .875rem; margin-bottom: 16px; line-height: 1.6; }
    .page-hero code { font-size: .85em; background: #142424; border: 1px solid #1a3030; padding: 1px 5px; border-radius: 4px; color: #5eead4; }
    .hero-meta { font-size: .78rem; color: #888; }
    .hero-meta .sep { margin: 0 6px; opacity: .4; }
    .hero-meta strong { color: #4ade80; }

    /* ── Grid ── */
    .prompts-grid {
      max-width: 1240px; margin: 0 auto;
      padding: 0 24px 56px;
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 16px;
      align-items: start;
    }

    /* ── Card ── */
    .card {
      background: #0d1a1a;
      border: 1px solid #1a3030;
      border-radius: 12px;
      padding: 18px;
      display: flex;
      flex-direction: column;
      gap: 12px;
      transition: border-color .2s;
    }
    .card:hover { border-color: rgba(94,234,212,.3); }

    .card-top { display: flex; align-items: center; justify-content: space-between; }
    .card-badges { display: flex; align-items: center; gap: 6px; }

    .badge-tier.free {
      background: rgba(74,222,128,.12); color: #4ade80;
      border: 1px solid rgba(74,222,128,.25);
      font-size: .65rem; font-weight: 700; letter-spacing: .06em;
      text-transform: uppercase; padding: 2px 8px; border-radius: 100px;
    }
    .badge-tested {
      display: inline-flex; align-items: center; gap: 3px;
      font-size: .68rem; color: #4ade80; font-weight: 500;
    }
    .badge-tokens {
      font-size: .68rem; color: #888;
      background: #142424; border: 1px solid #1a3030;
      padding: 2px 7px; border-radius: 5px;
    }

    .card-title { font-size: .9rem; font-weight: 600; color: #fff; line-height: 1.4; }

    .card-meta { display: flex; align-items: center; gap: 6px; }
    .badge-cat {
      font-size: .68rem; color: #5eead4; background: rgba(94,234,212,.08);
      border: 1px solid rgba(94,234,212,.15); padding: 2px 7px; border-radius: 5px;
    }
    .badge-expertise {
      font-size: .68rem; color: #c4b5fd;
      background: rgba(196,181,253,.08); border: 1px solid rgba(196,181,253,.15);
      padding: 2px 7px; border-radius: 5px;
    }

    .card-tags { display: flex; gap: 5px; flex-wrap: wrap; }
    .tag {
      font-size: .65rem; color: #888;
      background: #142424; border: 1px solid #1a3030;
      padding: 1px 7px; border-radius: 4px;
    }

    /* ── Actions ── */
    .card-actions { display: flex; flex-direction: column; gap: 0; margin-top: 4px; }

    .btn-copy {
      display: inline-flex; align-items: center; gap: 6px;
      align-self: flex-start;
      background: rgba(94,234,212,.08); border: 1px solid rgba(94,234,212,.25);
      color: #5eead4; font-size: .78rem; font-weight: 500;
      padding: 6px 13px; border-radius: 7px; cursor: pointer;
      transition: background .2s; font-family: inherit; margin-bottom: 8px;
    }
    .btn-copy:hover { background: rgba(94,234,212,.18); }


    /* ── Contribute ── */
    .contribute-banner {
      background: #0d1a1a; border-top: 1px solid #1a3030;
      padding: 48px 24px;
    }
    .contribute-inner {
      max-width: 1240px; margin: 0 auto;
      display: flex; align-items: center; justify-content: space-between;
      gap: 32px; flex-wrap: wrap;
    }
    .contribute-inner h3 { font-size: 1rem; color: #fff; margin-bottom: 6px; }
    .contribute-inner p { color: #999; font-size: .875rem; max-width: 500px; }
    .btn-contribute {
      display: inline-flex; align-items: center; gap: 8px;
      background: #142424; border: 1px solid #1a3030;
      color: #e0e0e0; font-size: .875rem; font-weight: 500;
      padding: 10px 18px; border-radius: 9px; text-decoration: none;
      white-space: nowrap; transition: border-color .2s, color .2s;
    }
    .btn-contribute:hover { border-color: #5eead4; color: #5eead4; }

    /* ── Footer ── */
    .site-footer { border-top: 1px solid #1a3030; padding: 40px 24px; text-align: center; margin-top: 24px; }
    .site-footer p { color: #888; font-size: 13px; }
    .footer-links { margin-top: 14px; display: flex; justify-content: center; gap: 20px; }
    .footer-links a { font-size: 12px; color: #888; text-decoration: none; }
    .footer-links a:hover { color: #5eead4; }
    .footer-green-link { display: inline-block; margin-top: 18px; opacity: .85; transition: opacity .2s; }
    .footer-green-link:hover { opacity: 1; }
    .footer-green-link img { display: block; width: 100px; height: auto; margin: 0 auto; }
    .footer-copy { margin-top: 12px; font-size: 11px; }

    /* ══════════ MOBILE SCENE · Phase B push (2026-08-26) ══════════
       Below 860px, drops the Brave browser-chrome and the dark theme entirely for the
       blurred-photo + iOS frosted-glass system shared with the other 3 mobile pages. */
    .m-statusbar, .m-bg, .m-scrim, .m-hero, .m-eco-banner { display: none; }

    @media (max-width: 860px) {
      .browser-titlebar, .browser-navbar { display: none; }
      .m-statusbar, .m-bg, .m-scrim, .m-hero, .m-eco-banner { display: block; }

      body { background: #f0e9da; }
      .browser-window, .browser-body, .page { background: transparent; }
      .page-hero { display: none; }

      .m-statusbar {
        position: sticky; top: 0; z-index: 30;
        display: flex; align-items: center; justify-content: space-between;
        height: 30px; padding: 0 16px;
        color: #fff; font-family: 'Helvetica Neue', Arial, sans-serif;
        text-shadow: 0 1px 4px rgba(0,0,0,.35);
      }
      .m-statusbar-brand { font-size: .72rem; font-weight: 800; }
      .m-statusbar-icons { display: flex; align-items: center; gap: 6px; }
      .m-statusbar-icons svg { display: block; }

      .m-bg {
        position: fixed; inset: -40px; z-index: -2;
        background: url('/images/wallpaper-beach.webp') center 55% / cover no-repeat;
        filter: blur(30px) saturate(1.15) brightness(.92);
        transform: scale(1.08);
      }
      .m-scrim { position: fixed; inset: 0; z-index: -1; background: rgba(20,18,14,.22); }

      .m-hero { padding: 18px 24px 4px; }
      .m-hero h1 { font-size: 1.4rem; font-weight: 700; color: #17140f; margin-bottom: 8px; }
      .m-hero p { font-size: .78rem; color: rgba(23,20,15,.75); line-height: 1.5; }

      .m-eco-banner {
        margin: 0 24px 20px;
        background: rgba(23,20,15,.5); backdrop-filter: blur(28px) saturate(150%); -webkit-backdrop-filter: blur(28px) saturate(150%);
        border: 1px solid rgba(255,255,255,.12); border-radius: 16px; padding: 14px 16px;
      }
      .m-eco-banner p { color: #fff; font-size: .76rem; line-height: 1.45; }

      .prompts-grid { grid-template-columns: 1fr; padding: 0 24px 40px; }
      .card {
        background: rgba(255,255,255,.42); backdrop-filter: blur(28px) saturate(150%); -webkit-backdrop-filter: blur(28px) saturate(150%);
        border: 1px solid rgba(255,255,255,.45); box-shadow: 0 8px 26px rgba(0,0,0,.12);
      }
      .card-title { color: #17140f; }
      .badge-tokens { color: rgba(23,20,15,.55); background: rgba(23,20,15,.06); border-color: rgba(23,20,15,.1); }
      .badge-tier.free { color: #1a7a3d; background: rgba(74,222,128,.22); border-color: rgba(26,122,61,.3); }
      .badge-tested { color: #1a7a3d; background: rgba(74,222,128,.22); border: 1px solid rgba(26,122,61,.3); font-size: .65rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; padding: 2px 8px; border-radius: 100px; }
      .badge-tested svg { display: none; }
      .badge-cat { color: #a8791f; background: rgba(224,163,46,.1); border-color: rgba(224,163,46,.25); }
      .badge-expertise { color: #5b3fa8; background: rgba(167,139,250,.12); border-color: rgba(167,139,250,.25); }
      .tag { color: rgba(23,20,15,.6); background: rgba(23,20,15,.06); border-color: rgba(23,20,15,.1); }

      .btn-copy { background: rgba(224,163,46,.16); border-color: rgba(224,163,46,.35); color: #a8791f; }
      .btn-copy:hover { background: rgba(224,163,46,.28); }

      .contribute-banner {
        background: rgba(255,255,255,.42); backdrop-filter: blur(28px) saturate(150%); -webkit-backdrop-filter: blur(28px) saturate(150%);
        border-top: 1px solid rgba(255,255,255,.45);
      }
      .contribute-inner h3 { color: #17140f; }
      .contribute-inner p { color: rgba(23,20,15,.65); }
      .btn-contribute { background: rgba(255,255,255,.5); border-color: rgba(23,20,15,.15); color: #17140f; }
      .btn-contribute:hover { border-color: #2e2a22; color: #2e2a22; }

      .site-footer { border-top-color: rgba(23,20,15,.15); }
      .site-footer p { color: rgba(23,20,15,.6); }
      .footer-links a { color: rgba(23,20,15,.6); }
      .footer-links a:hover { color: #17140f; }
    }
  </style>
</head>
<body>
<!-- MOBILE SCENE header · Phase B push (2026-08-26), replaces the Brave browser-chrome below 860px -->
<div class="m-statusbar">
  <div class="m-statusbar-brand">SecureLayer</div>
  <div class="m-statusbar-icons">
    <svg width="16" height="11" viewBox="0 0 16 11" fill="#fff"><rect x="0" y="7" width="3" height="4" rx=".5"/><rect x="4.5" y="5" width="3" height="6" rx=".5"/><rect x="9" y="3" width="3" height="8" rx=".5"/><rect x="13" y="0" width="3" height="11" rx=".5"/></svg>
    <svg width="15" height="13" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.55a11 11 0 0 1 14.08 0"/><path d="M1.42 9a16 16 0 0 1 21.16 0"/><path d="M8.53 16.11a6 6 0 0 1 6.95 0"/><line x1="12" y1="20" x2="12.01" y2="20"/></svg>
    <svg width="22" height="11" viewBox="0 0 24 12" fill="none"><rect x="1" y="1.5" width="19" height="9" rx="2.5" stroke="#fff" stroke-width="1.2"/><rect x="21.5" y="4.3" width="2" height="3.4" rx="1" fill="#fff"/><rect x="2.5" y="3" width="14" height="6" rx="1.2" fill="#fff"/></svg>
  </div>
</div>
<div class="m-bg" aria-hidden="true"></div>
<div class="m-scrim" aria-hidden="true"></div>
<div class="m-hero">
  <h1>AI Prompts to improve Cybersecurity</h1>
  <p>Tested by security engineers. Copy, paste into any AI assistant, fill in the placeholders, and run.</p>
</div>
<div class="browser-window">
  <div class="browser-titlebar">
    <div class="traffic-lights">
      <span class="tl red"></span><span class="tl yellow"></span><span class="tl green"></span>
    </div>
    <div class="browser-tab">
      <img class="tab-favicon" src="/favicon.svg" alt="" />
      <span class="tab-title">AI Prompts to improve Cybersecurity — SecureLayer</span>
      <span class="tab-close">&times;</span>
    </div>
    <span class="tab-add">+</span>
    <span class="tab-chevron">&#9660;</span>
  </div>
  <div class="browser-navbar">
    <span class="nav-icon nav-back"><svg viewBox="0 0 24 24" fill="none"><path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
    <span class="nav-icon nav-forward disabled"><svg viewBox="0 0 24 24" fill="none"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
    <span class="nav-icon nav-reload"><svg viewBox="0 0 24 24" fill="none"><path d="M4 12a8 8 0 0 1 14-5.3M20 12a8 8 0 0 1-14 5.3M4 4v5h5M20 20v-5h-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
    <span class="nav-icon nav-bookmark"><svg viewBox="0 0 24 24" fill="none"><path d="M6 3h12a1 1 0 0 1 1 1v17l-7-4-7 4V4a1 1 0 0 1 1-1Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg></span>
    <div class="address-pill">
      <svg viewBox="0 0 24 24" fill="none"><path d="M4 6h16M7 12h10M10 18h4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      <span class="addr-text">securelayer.co<span class="addr-path">/cybersecurity-ai-prompts/</span></span>
    </div>
    <span class="nav-divider"></span>
    <img class="nav-brave" src="/images/dock-icons/brave.png" alt="Brave" />
    <span class="nav-menu"><svg viewBox="0 0 24 24" fill="none"><path d="M4 6h16M4 12h16M4 18h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></span>
  </div>
  <div class="browser-body">

    <div class="page-hero">
      <div class="hero-badge">
        <span class="badge-dot"></span>
        Free · Tested · Ready to Use
      </div>
      <h1>AI Prompts to improve Cybersecurity</h1>
      <p>
        Tested by security engineers. Copy, paste into any AI assistant,
        fill in the <code>[REPLACE]</code> placeholders, and run.
      </p>
      <div class="hero-meta">
        <span id="visible-count">{freePrompts.length}</span> prompt{freePrompts.length !== 1 ? 's' : ''}
        <span class="sep">·</span>
        <strong>Free</strong>
      </div>
    </div>

    <div class="m-eco-banner">
      <p>Every AI prompt has a real energy cost — roughly the same as running a 10W LED bulb for two minutes. Run these thoughtfully — being frugal with AI is part of protecting our planet.</p>
    </div>

    <div class="prompts-grid" id="prompts-grid">
      {freePrompts.map(prompt => (
        <div class="card" data-category={prompt.data.category}>

          <div class="card-top">
            <div class="card-badges">
              <span class="badge-tier free">Free</span>
              {prompt.data.tested && (
                <span class="badge-tested">
                  <svg width="11" height="11" viewBox="0 0 16 16" fill="none">
                    <path d="M8 1L2 4v4c0 3.3 2.5 6.4 6 7 3.5-.6 6-3.7 6-7V4L8 1z" fill="#4ade80" opacity=".3"/>
                    <path d="M6 8l2 2 3-3" stroke="#4ade80" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                  Tested
                </span>
              )}
            </div>
            <span class="badge-tokens">~{prompt.data.token_estimate} tokens</span>
          </div>

          <h3 class="card-title">{prompt.data.title}</h3>

          <div class="card-meta">
            <span class="badge-cat">{prompt.data.category}</span>
            <span class="badge-expertise">{prompt.data.expertise}</span>
          </div>

          <div class="card-tags">
            {prompt.data.tags.slice(0, 3).map(tag => <span class="tag">{tag}</span>)}
          </div>

          <div class="card-actions">
            <button class="btn-copy" data-prompt-id={prompt.data.id} type="button">
              <svg width="13" height="13" viewBox="0 0 16 16" fill="none">
                <rect x="5" y="5" width="9" height="9" rx="1.5" stroke="currentColor" stroke-width="1.5"/>
                <path d="M11 5V3.5A1.5 1.5 0 009.5 2H3.5A1.5 1.5 0 002 3.5v6A1.5 1.5 0 003.5 11H5" stroke="currentColor" stroke-width="1.5"/>
              </svg>
              <span class="btn-copy-label">Copy</span>
            </button>
            <pre class="prompt-source" id={`prompt-${prompt.data.id}`} hidden>{prompt.body}</pre>
          </div>

        </div>
      ))}
    </div>

    <div class="contribute-banner">
      <div class="contribute-inner">
        <div>
          <h3>Want to contribute a prompt?</h3>
          <p>Open a pull request — every submission goes through automated schema validation and a human security review before publishing.</p>
        </div>
        <a href="https://github.com" class="btn-contribute" target="_blank" rel="noopener noreferrer">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>
          </svg>
          Contribute on GitHub
        </a>
      </div>
    </div>

    <footer class="site-footer">
      <p>Choose cybersecurity, it's cheaper.</p>
      <p class="footer-links">
        <a href="/">Home</a>
        <a href="/security">Security</a>
        <a href="/sustainability">Environment</a>
      </p>
      <a href="/sustainability" class="footer-green-link">
        <img src="/gwf-badge.png" alt="This website runs on green hosting - verified by thegreenwebfoundation.org" />
      </a>
      <p class="footer-copy">&copy; 2026 SecureLayer. All rights reserved.</p>
    </footer>

  </div>
</div>
<script is:inline>
  document.querySelectorAll('.btn-copy').forEach(btn => {
    btn.addEventListener('click', async () => {
      const id = btn.dataset.promptId;
      const src = document.getElementById(`prompt-${id}`);
      if (!src) return;
      try {
        await navigator.clipboard.writeText(src.textContent.trim());
        const label = btn.querySelector('.btn-copy-label');
        const original = label.textContent;
        label.textContent = 'Copied!';
        setTimeout(() => { label.textContent = original; }, 1800);
      } catch {
        // clipboard API unavailable (e.g. insecure context) — no-op, button stays as "Copy"
      }
    });
  });
</script>
</body>
</html>
