---
import Layout from '../layouts/Layout.astro';
import logoSource from '../../public/logo.svg?raw';

// Inlined (not <img>) so the glowing wallpaper mark can be recolored via
// CSS `currentColor` — the source file hardcodes fill="#000000" and also
// carries a tiny (~2% viewBox height) accessibility label that would read
// as visual noise at large size, so both are stripped here.
const logoMark = logoSource
  .replace('fill="#000000"', 'fill="currentColor"')
  .replace(/<text[^>]*>.*?<\/text>/s, '');
---

<Layout
  title="SecureLayer — Security is a habit, not a project"
  description="SecureLayer delivers tested cybersecurity prompts and an instant GitHub repository audit — the tools that make checking your security a habit, not a once-a-year project."
>

  <div class="os">

    <!-- MENU BAR -->
    <div class="menu-bar">
      <div class="menu-left">
        <img src="/logo.svg" alt="" class="menu-logo" />
        <span class="menu-brand">SecureLayer</span>
        <a href="#" class="menu-item" data-preview-file="secdevops-pipeline.png" data-preview-accent="#3a3428" data-preview-img="/images/previews/secdevops-pipeline.png">SecDevOps</a>
        <a href="#" class="menu-item" data-preview-file="security-page.png" data-preview-accent="var(--cyan)" data-preview-img="/images/previews/security-page.png">AppSec</a>
        <a href="#" class="menu-item" data-preview-file="itsec-overview.png" data-preview-accent="#7d7460" data-preview-img="/images/previews/itsec-overview.png">IT Sec</a>
      </div>
      <div class="menu-right">
        <span class="menu-battery-pct">88%</span>
        <svg class="menu-icon" width="20" height="14" viewBox="0 0 22 14" fill="none">
          <rect x="1" y="1.5" width="17" height="11" rx="2.5" stroke="currentColor" stroke-width="1.3"/>
          <rect x="19" y="5" width="2" height="4" rx="1" fill="currentColor"/>
          <path d="M11 2.3L6.6 7.8h3.1L8.2 12.2l4.9-5.5H10L11 2.3z" fill="currentColor"/>
        </svg>
        <svg class="menu-icon" width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M1 6c4-3.5 10-3.5 14 0M3.4 8.6c3-2.3 6.2-2.3 9.2 0M5.8 11.1c1.7-1.2 2.7-1.2 4.4 0" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/><circle cx="8" cy="13.2" r="1" fill="currentColor"/></svg>
        <span class="menu-clock" id="menu-clock"></span>
      </div>
    </div>

    <!-- DESKTOP -->
    <div class="desktop">
      <div class="wallpaper-photo" aria-hidden="true"></div>
      <div class="wallpaper-scrim" aria-hidden="true"></div>

      <!-- WIDGET · project note (macOS Stickies style) -->
      <div class="widget widget-note pos-tl">
        <div class="widget-watermark" set:html={logoMark} />
        <div class="note-body">
          <p><em>Security</em> is not a project,</p>
          <p>It's a <em>habit</em>,</p>
          <p>We can <strong>help you</strong><br /><em>make it stick</em>.</p>
        </div>
      </div>

      <!-- WIDGET · checklist -->
      <div class="widget widget-todo pos-tr">
        <div class="widget-watermark todo-watermark" set:html={logoMark} />
        <div class="todo-bar">
          <span class="todo-dot" style="background:#ff5f57;"></span>
          <span class="todo-dot" style="background:#febc2e;"></span>
          <span class="todo-dot" style="background:#28c840;"></span>
          <span class="todo-add">+</span>
        </div>
        <div class="todo-titlerow">
          <span class="todo-title">Reminders</span>
          <span class="todo-count">5</span>
        </div>
        <div class="todo-subrow"><span>0 Completed</span> · <a href="#">Clear</a><span class="todo-show">Show</span></div>
        <div class="todo-list">
          <div class="widget-todo-item"><span class="todo-check"></span>Improve the Open SSF ScoreCard</div>
          <div class="widget-todo-item"><span class="todo-check"></span>Check the Headers Security Grade</div>
          <div class="widget-todo-item"><span class="todo-check"></span>Check the SSL/TLS Server Security Grade</div>
          <div class="widget-todo-item"><span class="todo-check"></span>Merge some PRs related to cybersecurity</div>
          <div class="widget-todo-item"><span class="todo-check"></span>Assess the security level of Canva</div>
        </div>
      </div>

      <!-- WIDGET · file -->
      <a class="widget widget-file pos-mr" href="/docs/securelayer.co.pdf" target="_blank" rel="noopener">
        <div class="pdf-page">
          <div class="pdf-thumb"></div>
          <div class="pdf-badge">
            <svg width="11" height="11" viewBox="0 0 16 16" fill="none"><circle cx="7" cy="7" r="5" stroke="#fff" stroke-width="1.6"/><path d="M11 11l3.5 3.5" stroke="#fff" stroke-width="1.6" stroke-linecap="round"/></svg>
          </div>
          <div class="pdf-label">PDF</div>
        </div>
        <span>Make-Security-Pay-For-Itself.pdf</span>
      </a>

      <!-- WIDGET · quick-look preview (revealed on menu-bar hover) -->
      <div class="widget widget-preview pos-bl" id="preview-window">
        <div class="preview-titlebar">
          <span class="preview-btn preview-close">&times;</span>
          <span class="preview-btn preview-expand">
            <svg width="10" height="10" viewBox="0 0 16 16" fill="none"><path d="M6 2H2v4M10 14h4v-4M2 2l5 5M14 14l-5-5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
          <span class="preview-filename" id="preview-filename">security-page.png</span>
        </div>
        <div class="preview-body" id="preview-body">
          <img class="preview-img" id="preview-img" alt="" />
          <div class="preview-placeholder" id="preview-placeholder">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none"><path d="M12 3l7 3v5c0 4.6-3 7.9-7 9-4-1.1-7-4.4-7-9V6l7-3z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
            <span>Preview coming soon</span>
          </div>
        </div>
      </div>
    </div>

    <!-- DOCK · the real toolkit used for security work -->
    <div class="dock">
      <span class="dock-icon" title="Finder"><img src="/images/dock-icons/finder.png" alt="Finder" /></span>
      <span class="dock-icon" title="Tutanota" data-tooltip="contact@securelayer.co"><img src="/images/dock-icons/tuta.png" alt="Tutanota" /></span>
      <span class="dock-icon" title="Proton Mail" data-tooltip="contact@securelayer.co"><img src="/images/dock-icons/proton.png" alt="Proton Mail" /></span>
      <span class="dock-icon" title="Signal"><img src="/images/dock-icons/signal.png" alt="Signal" /></span>
      <span class="dock-icon" title="Molly"><img src="/images/dock-icons/molly.png" alt="Molly" /></span>
      <span class="dock-icon" title="VS Code"><img src="/images/dock-icons/vscode.png" alt="VS Code" /></span>
      <span class="dock-icon" title="Jupyter"><img src="/images/dock-icons/jupyter.png" alt="Jupyter" /></span>
      <span class="dock-icon" title="1Password"><img src="/images/dock-icons/1password.png" alt="1Password" /></span>
      <span class="dock-icon" title="iTerm2"><img src="/images/dock-icons/iterm2.svg" alt="iTerm2" /></span>
      <span class="dock-icon" title="NordVPN"><img src="/images/dock-icons/nordvpn.svg" alt="NordVPN" /></span>
      <span class="dock-icon" title="OWASP ZAP"><img src="/images/dock-icons/zap.svg" alt="OWASP ZAP" /></span>
      <span class="dock-icon" title="Multipass"><img src="/images/dock-icons/multipass.png" alt="Multipass" /></span>
      <span class="dock-icon" title="Yubico Authenticator"><img src="/images/dock-icons/yubico.png" alt="Yubico Authenticator" /></span>
      <span class="dock-icon" title="Obsidian"><img src="/images/dock-icons/obsidian.png" alt="Obsidian" /></span>
      <span class="dock-icon" title="Bitwarden"><img src="/images/dock-icons/bitwarden.png" alt="Bitwarden" /></span>
      <span class="dock-icon" title="OrbStack"><img src="/images/dock-icons/orbstack.png" alt="OrbStack" /></span>
      <span class="dock-icon" title="Ollama"><img src="/images/dock-icons/ollama.png" alt="Ollama" /></span>
      <a class="dock-icon" href="https://securelayer.co/security" title="Brave" data-tooltip="How secure is this website?"><img src="/images/dock-icons/brave.png" alt="Brave" /></a>
      <a class="dock-icon" href="https://securelayer.co/sustainability/" title="Firefox" data-tooltip="What is the impact of this website on the environment?"><img src="/images/dock-icons/firefox.png" alt="Firefox" /></a>
      <div class="dock-sep"></div>
      <div class="dock-icon dock-trash" title="Trash">
        <img src="/images/dock-icons/trash.png" alt="Trash" />
      </div>
    </div>

    <div class="dock-tooltip" id="dock-tooltip"></div>

  </div>

</Layout>

<style>
  /* the desktop's own menu bar replaces the standard site nav on this page,
     and a footer doesn't fit a full-viewport desktop scene */
  :global(nav) { display: none; }
  :global(footer) { display: none; }

  .os { position: relative; min-height: 100vh; display: flex; flex-direction: column; }

  /* MENU BAR */
  .menu-bar { display: flex; align-items: center; justify-content: space-between; padding: 0 16px; height: 27px; background: transparent; position: absolute; top: 0; left: 0; right: 0; z-index: 5; }
  .menu-left { display: flex; align-items: center; gap: 14px; overflow-x: auto; scrollbar-width: none; }
  .menu-left::-webkit-scrollbar { display: none; }
  .menu-logo { height: 15px; width: 15px; flex-shrink: 0; filter: brightness(0) invert(60%); opacity: .85; }
  .menu-brand { font-family: var(--font-round); font-weight: 800; font-size: .74rem; color: #4a4a4a; margin-right: 2px; flex-shrink: 0; white-space: nowrap; }
  .menu-item { font-size: .74rem; color: #4a4a4a; text-decoration: none; transition: color .15s; white-space: nowrap; flex-shrink: 0; }
  .menu-item:hover { color: #c4c4c4; }
  .menu-right { display: flex; align-items: center; gap: 12px; color: #4a4a4a; }
  .menu-clock { font-size: .74rem; line-height: normal; font-variant-numeric: tabular-nums; color: #4a4a4a; }
  .menu-battery-pct { font-size: .74rem; line-height: normal; font-variant-numeric: tabular-nums; color: #4a4a4a; }

  /* DESKTOP */
  .desktop { position: relative; flex: 1; min-height: 640px; overflow: hidden; background: var(--bg); }
  .wallpaper-photo { position: absolute; inset: 0; background: url('/images/wallpaper-beach.webp') center 55% / cover no-repeat; }
  .wallpaper-scrim { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(23,20,15,.06), rgba(23,20,15,.22) 55%, rgba(23,20,15,.4)); }

  .widget-watermark { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 120px; opacity: .1; color: #17140f; pointer-events: none; z-index: 0; }
  .widget-watermark :global(svg) { width: 100%; height: auto; display: block; }
  .todo-watermark { color: #17140f; opacity: .05; }

  /* WIDGETS */
  .widget { position: absolute; z-index: 2; overflow: hidden; background: var(--bg2); border: 1px solid var(--border); border-radius: 16px; padding: 18px 20px; box-shadow: 0 20px 40px -24px rgba(23,20,15,.3); max-width: 260px; }
  .pos-tl { top: 28px; left: 40px; }
  .pos-tr { top: 32px; right: 32px; }
  .pos-mr { top: 230px; left: 50%; transform: translateX(30px); }
  .pos-bl { top: 306px; left: 31px; }

  .widget-note { background: #eee6a8; border-color: #d9cd7a; width: 265px; height: 265px; max-width: 265px; padding: 22px 20px; border-radius: 3px; display: flex; flex-direction: column; justify-content: center; }
  .widget-note p { font-family: var(--font-head); font-size: 1.4rem; font-weight: 400; color: #2b2410; line-height: 1.3; }
  .widget-note p + p { margin-top: 16px; }
  .widget-note em { font-style: italic; font-weight: 700; }
  .widget-note strong { font-style: normal; font-weight: 700; }

  .widget-todo { background: #fdfdfd; border-color: rgba(0,0,0,.08); padding: 16px 18px 18px; max-width: 320px; }
  .todo-bar { display: flex; align-items: center; gap: 7px; margin-bottom: 14px; }
  .todo-dot { width: 10px; height: 10px; border-radius: 50%; }
  .todo-add { margin-left: auto; width: 20px; height: 20px; border-radius: 50%; border: 1px solid rgba(0,0,0,.15); color: rgba(0,0,0,.6); font-size: .8rem; display: flex; align-items: center; justify-content: center; }
  .todo-titlerow { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 8px; }
  .todo-title { font-family: var(--font-round); font-weight: 900; font-size: 1.3rem; color: #0a6cff; }
  .todo-count { font-family: var(--font-round); font-weight: 800; font-size: 1.6rem; color: #0a6cff; }
  .todo-subrow { font-size: .68rem; color: rgba(0,0,0,.4); padding-bottom: 10px; border-bottom: 1px solid rgba(0,0,0,.08); margin-bottom: 4px; }
  .todo-subrow a { color: #0a6cff; text-decoration: none; }
  .todo-show { float: right; color: #0a6cff; }
  .todo-list { display: flex; flex-direction: column; }
  .widget-todo-item { display: flex; align-items: center; gap: 10px; font-size: .74rem; color: rgba(0,0,0,.82); padding: 7px 0; }
  .todo-check { width: 14px; height: 14px; border-radius: 50%; border: 1.3px solid rgba(0,0,0,.25); flex-shrink: 0; }

  .widget-file { display: flex; flex-direction: column; align-items: center; gap: 6px; background: transparent; border: none; box-shadow: none; overflow: visible; text-align: center; text-decoration: none; cursor: pointer; }
  .pdf-page { width: 62px; height: 76px; background: #fdfdfd; border-radius: 2px; position: relative; box-shadow: 0 4px 10px rgba(0,0,0,.22); }
  .pdf-page::before { content: ""; position: absolute; top: 0; right: 0; width: 0; height: 0; border-style: solid; border-width: 0 14px 14px 0; border-color: transparent #dcdcdc transparent transparent; }
  .pdf-thumb { position: absolute; top: 12px; left: 8px; right: 8px; height: 32px; border-radius: 2px; background: url('/images/wallpaper-beach.webp') center 60% / cover no-repeat; box-shadow: 0 0 0 1px rgba(0,0,0,.06); }
  .pdf-badge { position: absolute; bottom: 16px; right: 6px; width: 20px; height: 20px; border-radius: 50%; background: linear-gradient(180deg, #c6c6c6, #8c8c8c); display: flex; align-items: center; justify-content: center; box-shadow: 0 1px 3px rgba(0,0,0,.35); }
  .pdf-label { position: absolute; bottom: 4px; left: 0; right: 0; text-align: center; font-family: var(--font-round); font-size: .58rem; font-weight: 800; letter-spacing: .04em; color: #555; }
  .widget-file span { font-size: .72rem; color: #fff; font-weight: 600; text-shadow: 0 1px 4px rgba(0,0,0,.4); }

  .widget-preview {
    --preview-accent: var(--cyan);
    background: rgba(40,37,30,.6); backdrop-filter: blur(14px); border: 1px solid rgba(240,233,218,.14);
    padding: 0; opacity: 0; transform: translateY(6px) scale(.98); pointer-events: none;
    transition: opacity .18s ease, transform .18s ease; max-width: none;
  }
  .widget-preview.is-visible { opacity: 1; transform: translateY(0) scale(1); }
  .preview-titlebar { display: flex; align-items: center; gap: 8px; padding: 10px 12px; }
  .preview-btn { width: 16px; height: 16px; border-radius: 50%; background: rgba(240,233,218,.14); color: rgba(240,233,218,.75); display: flex; align-items: center; justify-content: center; font-size: .8rem; line-height: 1; flex-shrink: 0; }
  .preview-filename { font-size: .7rem; color: rgba(240,233,218,.85); font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .preview-body { width: 293px; height: 297px; margin: 0 12px 12px; border-radius: 10px; background: linear-gradient(155deg, color-mix(in srgb, var(--preview-accent) 55%, transparent), rgba(0,0,0,.2)); border: 1px dashed rgba(240,233,218,.25); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; color: rgba(240,233,218,.75); overflow: hidden; }
  .preview-body span { font-size: .68rem; font-weight: 600; }
  .preview-img { display: none; width: 100%; height: 100%; object-fit: cover; object-position: top; }
  .preview-body.has-image { border-style: solid; border-color: rgba(240,233,218,.18); background: #0e0e0e; }
  .preview-body.has-image .preview-img { display: block; }
  .preview-body.has-image .preview-placeholder { display: none; }

  /* DOCK */
  .dock {
    position: absolute; left: 50%; bottom: 22px; transform: translateX(-50%); z-index: 6;
    display: flex; align-items: center; gap: 9px; padding: 9px 12px;
    background: rgba(255,255,255,.14); backdrop-filter: blur(20px) saturate(160%); -webkit-backdrop-filter: blur(20px) saturate(160%);
    border: 1px solid rgba(255,255,255,.25); border-radius: 20px; box-shadow: 0 14px 34px rgba(0,0,0,.35);
    max-width: calc(100vw - 32px); overflow-x: auto; scrollbar-width: none;
  }
  .dock::-webkit-scrollbar { display: none; }
  .dock-icon {
    width: 38px; height: 38px; box-sizing: border-box; padding: 6px; border-radius: 10px;
    background: #fbfaf8; box-shadow: 0 1px 3px rgba(0,0,0,.25), inset 0 0 0 1px rgba(0,0,0,.04);
    display: flex; align-items: center; justify-content: center; text-decoration: none; transition: transform .15s; flex-shrink: 0;
  }
  .dock-icon img { width: 100%; height: 100%; object-fit: contain; }
  .dock-icon:hover { transform: translateY(-6px); }
  .dock-sep { width: 1px; height: 28px; background: rgba(240,233,218,.2); margin: 0 4px; flex-shrink: 0; }
  .dock-trash { background: transparent; box-shadow: none; padding: 0; }

  .dock-tooltip {
    position: fixed; z-index: 20; top: 0; left: 0; transform: translate(-50%, calc(-100% - 15px)) translateY(4px);
    background: #fbfaf8; color: #2b2410; font-family: var(--font-round); font-weight: 700; font-size: .78rem;
    padding: 7px 12px; border-radius: 8px; box-shadow: 0 8px 20px rgba(0,0,0,.35); white-space: nowrap;
    opacity: 0; pointer-events: none; transition: opacity .15s ease, transform .15s ease;
  }
  .dock-tooltip::after {
    content: ""; position: absolute; top: 100%; left: 50%; transform: translateX(-50%);
    border: 6px solid transparent; border-top-color: #fbfaf8;
  }
  .dock-tooltip.is-visible { opacity: 1; transform: translate(-50%, calc(-100% - 15px)) translateY(0); }

  @media (max-width: 860px) {
    .menu-left { gap: 12px; }
    .menu-item { display: none; }
    .widget { position: relative; max-width: none; margin: 12px auto; width: calc(100% - 32px); }
    .widget-note { width: 265px; max-width: calc(100% - 32px); }
    .pos-tl, .pos-tr, .pos-mr, .pos-bl { top: auto; left: auto; right: auto; bottom: auto; }
    .widget-preview { display: none; }
    .desktop { display: flex; flex-direction: column; padding: 24px 0; min-height: 0; }
    .dock { position: relative; left: auto; bottom: auto; transform: none; width: 100%; border-radius: 0; background: rgba(23,20,15,.55); backdrop-filter: blur(10px); box-shadow: none; border: none; }
  }
</style>

<script is:inline src="/scripts/index-widgets.js"></script>
