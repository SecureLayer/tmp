<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AI Agent Security — securelayer.co</title>
    <meta
      name="description"
      content="Can your agents be talked into anything? An assessment and incident-response service for AI agents — the exact failure mode behind the 2026 Reuters OpenAI hijack story."
    />
    <style>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        background: #0a0f0f;
        color: #e0e0e0;
        font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
        font-size: 14px;
        line-height: 1.6;
        min-height: 100vh;
      }

      a {
        color: inherit;
        text-decoration: none;
      }
      a:hover {
        text-decoration: underline;
      }

      .page {
        max-width: 880px;
        margin: 0 auto;
        padding: 48px 24px 24px;
      }

      /* ── Hero (title + intro), then cards in the /security style ── */
      .ai-hero {
        text-align: center;
        margin-bottom: 40px;
      }
      .ai-hero h1 {
        font-size: 2rem;
        line-height: 1.3;
        margin-bottom: 18px;
        color: #fff;
      }
      .ai-hero p {
        color: #aab;
        max-width: 640px;
        margin: 0 auto 8px;
      }
      .ai-hero a {
        color: #5eead4;
        text-decoration: underline;
      }
      .ai-hero code {
        font-family: ui-monospace, Menlo, monospace;
        color: #5eead4;
        white-space: nowrap;
      }
      .ai-card {
        background: #0d1a1a;
        border: 1px solid #1a3030;
        border-radius: 8px;
        padding: 26px 28px;
        margin-bottom: 16px;
      }
      .ai-card + .ai-card {
        margin-top: 0;
      }
      .as-eyebrow {
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.8px;
        text-transform: uppercase;
        color: #5eead4;
        margin-bottom: 10px;
      }
      .as-question {
        font-size: 1.2rem;
        line-height: 1.35;
        color: #fff;
        margin-bottom: 12px;
      }
      .as-desc {
        color: #b4bcbc;
        margin-bottom: 16px;
      }
      .as-desc a {
        color: #5eead4;
        text-decoration: underline;
      }
      .as-highlight {
        border-left: 2px solid #5eead4;
        background: rgba(94, 234, 212, 0.06);
        border-radius: 0 6px 6px 0;
        padding: 10px 14px;
        color: #9aa5a5;
      }
      .as-highlight strong {
        color: #e8eeee;
      }
      .ai-card-cta h2 {
        font-size: 1.2rem;
        line-height: 1.35;
        color: #fff;
        margin-bottom: 10px;
      }
      .ai-card-cta p {
        color: #b4bcbc;
        margin-bottom: 18px;
      }
      .contact-btn {
        display: inline-block;
        background: #0d2a2a;
        border: 1px solid #0d9488;
        border-radius: 5px;
        color: #5eead4;
        font-size: 13px;
        font-weight: 600;
        padding: 8px 20px;
        text-decoration: none;
        white-space: nowrap;
        transition: background 0.15s;
      }
      .contact-btn:hover {
        background: #0d3535;
        text-decoration: none;
      }
      .ai-card-split {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
      }
      .ai-card-split h2 {
        margin: 0;
        font-size: 1.2rem;
        line-height: 1.35;
        color: #fff;
      }
      .browser-window {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      .browser-titlebar {
        display: flex;
        align-items: center;
        gap: 14px;
        background: #170f20;
        padding: 10px 16px 0;
        border-bottom: 1px solid #2a2038;
      }
      .traffic-lights {
        display: flex;
        gap: 8px;
        padding-bottom: 10px;
        flex-shrink: 0;
      }
      .tl {
        width: 12px;
        height: 12px;
        border-radius: 50%;
      }
      .tl.red {
        background: #ff5f57;
      }
      .tl.yellow {
        background: #febc2e;
      }
      .tl.green {
        background: #28c840;
      }

      .browser-tab {
        display: flex;
        align-items: center;
        gap: 8px;
        background: #241a30;
        border-radius: 8px 8px 0 0;
        padding: 8px 12px;
        max-width: 260px;
      }
      .tab-favicon {
        width: 15px;
        height: 15px;
        flex-shrink: 0;
      }
      .tab-title {
        font-size: 12.5px;
        color: #e4dcf0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .tab-close {
        margin-left: auto;
        color: #7a6f8c;
        font-size: 15px;
        line-height: 1;
        flex-shrink: 0;
      }
      .tab-add {
        color: #7a6f8c;
        font-size: 18px;
        padding: 0 10px 10px;
        line-height: 1;
        align-self: center;
      }
      .tab-chevron {
        color: #7a6f8c;
        font-size: 12px;
        margin-left: auto;
        padding-bottom: 10px;
        align-self: center;
      }

      .browser-navbar {
        display: flex;
        align-items: center;
        gap: 14px;
        background: #1d1428;
        padding: 10px 16px;
        border-bottom: 1px solid #2a2038;
      }
      .nav-icon {
        color: #8a7fa0;
        flex-shrink: 0;
        display: flex;
        align-items: center;
      }
      .nav-icon svg {
        width: 17px;
        height: 17px;
      }
      .nav-icon.disabled {
        color: #453b56;
      }
      .address-pill {
        flex: 1;
        display: flex;
        align-items: center;
        gap: 8px;
        background: #2a2038;
        border-radius: 7px;
        padding: 7px 14px;
        max-width: 640px;
        margin: 0 auto;
      }
      .address-pill svg {
        width: 14px;
        height: 14px;
        color: #8a7fa0;
        flex-shrink: 0;
      }
      .addr-text {
        font-size: 13px;
        color: #e4dcf0;
      }
      .addr-path {
        color: #9187a6;
      }
      .nav-divider {
        width: 1px;
        height: 20px;
        background: #362a48;
        flex-shrink: 0;
      }
      .nav-brave {
        width: 20px;
        height: 20px;
        flex-shrink: 0;
      }
      .nav-menu svg {
        width: 18px;
        height: 18px;
      }

      .browser-body {
        flex: 1;
      }
      /* ── Footer ── */
      .site-footer {
        border-top: 1px solid #1a3030;
        padding: 40px 24px;
        text-align: center;
        margin-top: 24px;
      }
      .site-footer p {
        color: #888;
        font-size: 13px;
      }
      .footer-links {
        margin-top: 14px;
        display: flex;
        justify-content: center;
        gap: 20px;
      }
      .footer-links a {
        font-size: 12px;
        color: #888;
        text-decoration: none;
      }
      .footer-links a:hover {
        color: #5eead4;
      }
      .footer-green-link {
        display: inline-block;
        margin-top: 18px;
        opacity: 0.85;
        transition: opacity 0.2s;
      }
      .footer-green-link:hover {
        opacity: 1;
      }
      .footer-green-link img {
        display: block;
        width: 100px;
        height: auto;
        margin: 0 auto;
      }
      .footer-copy {
        margin-top: 12px;
        font-size: 12px;
      }

      /* ══════════ MOBILE SCENE (below 860px) ══════════
         Same treatment as /security: no browser frame, blurred photo + frosted-glass cards. */
      .m-statusbar,
      .m-bg,
      .m-scrim {
        display: none;
      }
      @media (max-width: 860px) {
        .browser-titlebar,
        .browser-navbar {
          display: none;
        }
        .m-statusbar,
        .m-bg,
        .m-scrim {
          display: block;
        }
        body {
          background: #f0e9da;
        }
        .browser-window,
        .browser-body,
        .page {
          background: transparent;
        }
        .page {
          padding: 8px 16px 24px;
        }
        .m-statusbar {
          position: sticky;
          top: 0;
          z-index: 30;
          display: flex;
          align-items: center;
          justify-content: space-between;
          height: 30px;
          padding: 0 16px;
          color: #fff;
          font-family: "Helvetica Neue", Arial, sans-serif;
          text-shadow: 0 1px 4px rgba(0, 0, 0, 0.35);
        }
        .m-statusbar-brand {
          font-size: 0.72rem;
          font-weight: 800;
        }
        .m-statusbar-icons {
          display: flex;
          align-items: center;
          gap: 6px;
        }
        .m-statusbar-icons svg {
          display: block;
        }
        .m-bg {
          position: fixed;
          inset: -40px;
          z-index: -2;
          background: url("/images/wallpaper-beach-blur.webp") center 55% /
            cover no-repeat;
          filter: blur(30px) saturate(1.15) brightness(0.92);
          transform: scale(1.08);
        }
        .m-scrim {
          position: fixed;
          inset: 0;
          z-index: -1;
          background: rgba(20, 18, 14, 0.22);
        }

        .ai-hero {
          text-align: left;
          margin: 10px 8px 18px;
        }
        .ai-hero h1 {
          font-size: 1.4rem;
          color: #17140f;
          margin-bottom: 8px;
        }
        .ai-hero p {
          font-size: 0.85rem;
          line-height: 1.5;
          color: rgba(23, 20, 15, 0.75);
          max-width: none;
          margin: 0 0 8px;
        }
        .ai-hero a {
          color: #17140f;
          font-weight: 600;
        }
        .ai-hero code {
          color: #0b4f48;
          font-weight: 700;
        }
        .ai-card {
          background: rgba(255, 255, 255, 0.42);
          backdrop-filter: blur(28px) saturate(150%);
          -webkit-backdrop-filter: blur(28px) saturate(150%);
          border: 1px solid rgba(255, 255, 255, 0.45);
          box-shadow: 0 8px 26px rgba(0, 0, 0, 0.12);
          padding: 20px 18px;
        }
        .as-eyebrow {
          color: rgba(23, 20, 15, 0.55);
        }
        .as-question,
        .ai-card-cta h2,
        .ai-card-split h2 {
          color: #17140f;
          font-size: 1.1rem;
        }
        .as-desc,
        .ai-card-cta p {
          color: rgba(23, 20, 15, 0.72);
          font-size: 0.9rem;
        }
        .as-desc a {
          color: #0d6d63;
        }
        .as-highlight {
          border-left-color: #0d6d63;
          background: rgba(255, 255, 255, 0.35);
          color: rgba(23, 20, 15, 0.7);
        }
        .as-highlight strong {
          color: #17140f;
        }
        .contact-btn {
          background: #2e2a22;
          border-color: #2e2a22;
          color: #f0e9da;
        }
        .contact-btn:hover {
          background: #17140f;
        }
        .site-footer {
          border-top-color: rgba(23, 20, 15, 0.15);
          padding: 28px 8px;
        }
        .site-footer p {
          color: rgba(23, 20, 15, 0.6);
        }
        .footer-links a {
          color: rgba(23, 20, 15, 0.6);
        }
        .footer-links a:hover {
          color: #17140f;
        }
      }
    </style>
  </head>
