---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => data.published !== false);
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const categoryLabel: Record<string, string> = {
  'case-study': 'Case Study',
  'guide': 'Guide',
  'tutorial': 'Tutorial',
  'analysis': 'Analysis',
};
---

<Layout title={`${post.data.title} — SecureLayer`} description={post.data.description}>
  <article class="post-wrap">
    <div class="post-header">
      <a href="/blog" class="back-link">← Blog</a>
      <div class="post-meta">
        <span class={`badge-cat cat-${post.data.category}`}>{categoryLabel[post.data.category] ?? post.data.category}</span>
        <span class="post-date">{new Date(post.data.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
        {post.data.readingTime && <span class="post-read">{post.data.readingTime} min read</span>}
      </div>
      <h1>{post.data.title}</h1>
      <p class="post-desc">{post.data.description}</p>
      <div class="post-tags">
        {post.data.tags.map(tag => <span class="tag">{tag}</span>)}
      </div>
    </div>

    <div class="post-body">
      <Content />
    </div>

    <div class="post-footer">
      <a href="/blog" class="back-link">← All posts</a>
      <div class="footer-ctas">
        <a href="/github-security-assessment" class="btn-cta">Try the GitHub Audit →</a>
        <a href="/free-cybersecurity-ai-prompts" class="btn-cta-ghost">Free Prompts</a>
      </div>
    </div>
  </article>
</Layout>

<style>
  .post-wrap { max-width: 720px; margin: 0 auto; padding: 120px 24px 100px; }

  .back-link { display: inline-flex; align-items: center; gap: 6px; font-size: .82rem; color: var(--muted); text-decoration: none; transition: color .2s; margin-bottom: 24px; }
  .back-link:hover { color: var(--cyan); }

  .post-header { margin-bottom: 48px; }
  .post-meta { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 20px; }

  .badge-cat { font-size: .7rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; padding: 3px 10px; border-radius: 100px; }
  .cat-case-study { background: rgba(167,139,250,.12); color: var(--cyan); border: 1px solid rgba(167,139,250,.2); }
  .cat-guide { background: rgba(34,197,94,.1); color: var(--green); border: 1px solid rgba(34,197,94,.2); }
  .cat-tutorial { background: rgba(251,191,36,.08); color: #fbbf24; border: 1px solid rgba(251,191,36,.2); }
  .cat-analysis { background: rgba(196,181,253,.08); color: var(--purple); border: 1px solid rgba(196,181,253,.15); }

  .post-date, .post-read { font-size: .78rem; color: var(--muted); }

  .post-header h1 { font-family: var(--font-head); font-size: clamp(1.6rem, 4vw, 2.2rem); font-weight: 700; color: var(--white); line-height: 1.2; margin-bottom: 16px; }
  .post-desc { font-size: 1rem; color: var(--muted); line-height: 1.65; margin-bottom: 20px; }
  .post-tags { display: flex; gap: 6px; flex-wrap: wrap; }
  .tag { font-size: .68rem; color: var(--muted); background: var(--bg3); border: 1px solid var(--border2); padding: 2px 8px; border-radius: 4px; }

  /* MARKDOWN BODY */
  .post-body { color: var(--text); line-height: 1.75; }
  .post-body :global(h2) { font-family: var(--font-head); font-size: 1.25rem; color: var(--white); margin: 48px 0 16px; padding-bottom: 8px; border-bottom: 1px solid var(--border); }
  .post-body :global(h3) { font-family: var(--font-head); font-size: 1rem; color: var(--white); margin: 28px 0 10px; }
  .post-body :global(p) { margin-bottom: 20px; color: var(--muted); font-size: .95rem; }
  .post-body :global(strong) { color: var(--text); font-weight: 600; }
  .post-body :global(a) { color: var(--cyan); text-decoration: underline; text-underline-offset: 3px; }
  .post-body :global(a:hover) { opacity: .8; }
  .post-body :global(code) { font-family: var(--font-mono); font-size: .8rem; background: var(--bg3); border: 1px solid var(--border2); padding: 2px 6px; border-radius: 4px; color: var(--purple); }
  .post-body :global(pre) { background: #0a0f1a; border: 1px solid var(--border); border-radius: 10px; padding: 20px; overflow-x: auto; margin: 24px 0; }
  .post-body :global(pre code) { background: none; border: none; padding: 0; font-size: .82rem; color: #cbd5e1; }
  .post-body :global(ul), .post-body :global(ol) { padding-left: 24px; margin-bottom: 20px; }
  .post-body :global(li) { color: var(--muted); font-size: .95rem; margin-bottom: 8px; }
  .post-body :global(blockquote) { border-left: 3px solid var(--cyan); padding-left: 20px; margin: 24px 0; }
  .post-body :global(blockquote p) { color: var(--muted); font-style: italic; }
  .post-body :global(table) { width: 100%; border-collapse: collapse; margin: 24px 0; font-size: .875rem; }
  .post-body :global(th) { text-align: left; padding: 10px 16px; background: var(--bg3); color: var(--white); font-family: var(--font-head); font-size: .8rem; border: 1px solid var(--border); }
  .post-body :global(td) { padding: 10px 16px; color: var(--muted); border: 1px solid var(--border2); }
  .post-body :global(tr:nth-child(even) td) { background: rgba(255,255,255,.02); }
  .post-body :global(hr) { border: none; border-top: 1px solid var(--border); margin: 48px 0; }

  .post-footer { margin-top: 64px; padding-top: 32px; border-top: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px; }
  .footer-ctas { display: flex; gap: 12px; flex-wrap: wrap; }
  .btn-cta { background: var(--cyan); color: #080c14; padding: 10px 20px; border-radius: 8px; font-size: .875rem; font-weight: 700; text-decoration: none; transition: opacity .2s; }
  .btn-cta:hover { opacity: .88; }
  .btn-cta-ghost { border: 1px solid var(--border); color: var(--text); padding: 10px 20px; border-radius: 8px; font-size: .875rem; text-decoration: none; transition: border-color .2s, color .2s; }
  .btn-cta-ghost:hover { border-color: var(--cyan); color: var(--cyan); }
</style>
